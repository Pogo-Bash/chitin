// Chitin phase-0 subset of Ladybird's Libraries/LibWeb/DOM/ChildNode.idl (BSD-2-Clause, the Ladybird developers).
// Members kept as written upstream; members the toy does not implement are left out.
// https://dom.spec.whatwg.org/#interface-childnode
interface mixin ChildNode {
    [CEReactions, Unscopable] undefined remove();
};
