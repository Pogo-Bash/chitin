// Chitin phase-0 subset of Ladybird's Libraries/LibWeb/HTML/HTMLElement.idl (BSD-2-Clause, the Ladybird developers).
// Members kept as written upstream; members the toy does not implement are left out.
// https://html.spec.whatwg.org/multipage/dom.html#htmlelement
[Exposed=Window]
interface HTMLElement : Element {
    // https://drafts.csswg.org/cssom/#the-elementcssinlinestyle-mixin (ElementCSSInlineStyle)
    [SameObject, PutForwards=cssText] readonly attribute CSSStyleDeclaration style;

    // https://drafts.csswg.org/cssom-view/#extensions-to-the-htmlelement-interface
    readonly attribute long offsetTop;
    readonly attribute long offsetLeft;
    readonly attribute long offsetWidth;
    readonly attribute long offsetHeight;
};
