+// For an embedder that keeps the databases (Internal/Persistence.h): what this transaction changed, before its logs go.
+void IDBTransaction::persist_committed_changes()
+{
+    if (!has_persistence_sink() || m_mode == TransactionMode::Readonly)
+        return;
+    Vector<CommittedStore> stores;
+    for (auto const& entry : m_store_mutation_logs)
+        stores.append({ entry.store, *entry.log });
+    persist_committed_transaction(*m_connection->associated_database(), is_upgrade_transaction(), stores);
+}
