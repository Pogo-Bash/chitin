+void Database::for_each_database_with_key(AK::Function<void(StorageAPI::StorageKey const&, Database&)> const& visitor)
+{
+    for (auto const& [key, mapping] : idb_databases()) {
+        for (auto const& [_, database] : mapping) {
+            if (database)
+                visitor(key, *database);
+        }
+    }
+}
+
+Optional<StorageAPI::StorageKey> Database::storage_key_of(Database const& wanted)
+{
+    for (auto const& [key, mapping] : idb_databases()) {
+        for (auto const& [_, database] : mapping) {
+            if (database && &*database == &wanted)
+                return key;
+        }
+    }
+    return {};
+}
