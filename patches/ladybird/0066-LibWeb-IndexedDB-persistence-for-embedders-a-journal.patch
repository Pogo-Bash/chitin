+
+#pragma once
+
+#include <AK/ByteBuffer.h>
+#include <AK/Function.h>
+#include <AK/Vector.h>
+#include <LibGC/Ptr.h>
+#include <LibWeb/Export.h>
+#include <LibWeb/Forward.h>
+#include <LibWebCommon/StorageAPI/StorageKey.h>
+
+namespace Web::IndexedDB {
+
+class Database;
+class MutationLog;
+class ObjectStore;
+
+// Persistence for embedders that keep IndexedDB themselves (the databases otherwise live in memory only, and a reload
+// starts with none). After each committed transaction and each deleted database the sink gets a journal entry: the
+// operations that bring a copy up to date (records stored and deleted, key generators; for an upgrade transaction the
+// whole database). An embedder appends the entries to its own storage and, before the next page of the origin runs,
+// replays them with import_journal(); export_snapshot() gives the same state as one entry, for compaction.
+//
+// Entry: "CIDB" u32 version 1, the storage key's origin (string), then operations to the end. Strings are u32 length
+// + UTF-8, numbers little-endian. Values are LibWeb's storage serialization records as they are (LBSC, versioned).
+using PersistenceSink = Function<void(ByteBuffer)>;
+WEB_API void set_persistence_sink(PersistenceSink);
+[[nodiscard]] bool has_persistence_sink();
+
+struct CommittedStore {
+    GC::Ref<ObjectStore> store;
+    GC::Ref<MutationLog> log;
+};
+void persist_committed_transaction(Database&, bool is_upgrade, Vector<CommittedStore> const&);
+void persist_database_deleted(StorageAPI::StorageKey const&, Utf16String const& name);
+
+// Replays a sequence of journal entries (concatenated). Databases with open connections are not touched; nothing
+// may be open yet when an embedder restores at start.
+WEB_API ErrorOr<void> import_journal(ReadonlyBytes);
+// Every database of every storage key, one entry per key, concatenated.
+WEB_API ByteBuffer export_snapshot();
+
+}
