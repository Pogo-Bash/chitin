+bool WebGL2RenderingContextImpl::validate_pixel_unpack_buffer_upload(WebIDL::LongLong offset)
+{
+    if (!m_pixel_unpack_buffer_binding) {
+        set_error(GL_INVALID_OPERATION);
+        return false;
+    }
+    if (offset < 0) {
+        set_error(GL_INVALID_VALUE);
+        return false;
+    }
+    return true;
+}
+
+void WebGL2RenderingContextImpl::tex_image3d(WebIDL::UnsignedLong target, WebIDL::Long level, WebIDL::Long internalformat, WebIDL::Long width, WebIDL::Long height, WebIDL::Long depth, WebIDL::Long border, WebIDL::UnsignedLong format, WebIDL::UnsignedLong type, WebIDL::LongLong pbo_offset)
+{
+    m_context->make_current();
+    if (!validate_pixel_unpack_buffer_upload(pbo_offset))
+        return;
+    m_context->tex_image_from_pixel_unpack_buffer(2, target, level, internalformat, 0, 0, 0, width, height, depth, border, format, type, 0, pbo_offset);
+}
+
+void WebGL2RenderingContextImpl::tex_sub_image3d(WebIDL::UnsignedLong target, WebIDL::Long level, WebIDL::Long xoffset, WebIDL::Long yoffset, WebIDL::Long zoffset, WebIDL::Long width, WebIDL::Long height, WebIDL::Long depth, WebIDL::UnsignedLong format, WebIDL::UnsignedLong type, WebIDL::LongLong pbo_offset)
+{
+    m_context->make_current();
+    if (!validate_pixel_unpack_buffer_upload(pbo_offset))
+        return;
+    m_context->tex_image_from_pixel_unpack_buffer(3, target, level, 0, xoffset, yoffset, zoffset, width, height, depth, 0, format, type, 0, pbo_offset);
+}
+
+void WebGL2RenderingContextImpl::compressed_tex_image3d(WebIDL::UnsignedLong target, WebIDL::Long level, WebIDL::UnsignedLong internalformat, WebIDL::Long width, WebIDL::Long height, WebIDL::Long depth, WebIDL::Long border, WebIDL::Long image_size, WebIDL::LongLong offset)
+{
+    m_context->make_current();
+    if (!validate_pixel_unpack_buffer_upload(offset))
+        return;
+    m_context->tex_image_from_pixel_unpack_buffer(6, target, level, internalformat, 0, 0, 0, width, height, depth, border, 0, 0, image_size, offset);
+}
+
+void WebGL2RenderingContextImpl::compressed_tex_sub_image3d(WebIDL::UnsignedLong target, WebIDL::Long level, WebIDL::Long xoffset, WebIDL::Long yoffset, WebIDL::Long zoffset, WebIDL::Long width, WebIDL::Long height, WebIDL::Long depth, WebIDL::UnsignedLong format, WebIDL::Long image_size, WebIDL::LongLong offset)
+{
+    m_context->make_current();
+    if (!validate_pixel_unpack_buffer_upload(offset))
+        return;
+    m_context->tex_image_from_pixel_unpack_buffer(7, target, level, 0, xoffset, yoffset, zoffset, width, height, depth, 0, format, 0, image_size, offset);
+}
+
 }
