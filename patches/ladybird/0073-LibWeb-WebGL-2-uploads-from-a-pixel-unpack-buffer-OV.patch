new file mode 100644
index 0000000000..a245fc0a63
--- /dev/null
+++ b/Libraries/LibWeb/WebGL/Extensions/OVRMultiview2.cpp
@@ -0,0 +1,54 @@
+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/StringBuilder.h>
+#include <GLES2/gl2.h>
+#include <LibWeb/Bindings/OVRMultiview2.h>
+#include <LibWeb/WebGL/Extensions/OVRMultiview2.h>
+#include <LibWeb/WebGL/WebGLRenderingContextBase.h>
+#include <LibWeb/WebGL/WebGLTexture.h>
+
+namespace Web::WebGL {
+
+GC_DEFINE_ALLOCATOR(OVRMultiview2);
+
+GC::Ref<Bindings::Wrappable> OVRMultiview2::create(GC::Ref<WebGLRenderingContextBase> context)
+{
+    auto& realm = context->realm();
+    return realm.create<OVRMultiview2>(realm, context);
+}
+
+OVRMultiview2::OVRMultiview2(JS::Realm&, GC::Ref<WebGLRenderingContextBase> context)
+    : m_context(context)
+{
+}
+
+void OVRMultiview2::framebuffer_texture_multiview_ovr(GLenum target, GLenum attachment, GC::Ptr<WebGLTexture> texture, GLint level, GLint base_view_index, GLsizei num_views)
+{
+    StringBuilder args;
+    args.appendff("{},{},", target, attachment);
+    if (texture) {
+        // A texture of another context (or a deleted one) is INVALID_OPERATION, as for framebufferTextureLayer.
+        auto handle = texture->handle(m_context.ptr());
+        if (handle.is_error()) {
+            m_context->set_error(GL_INVALID_OPERATION);
+            return;
+        }
+        args.appendff("\"@{}\"", handle.value());
+    } else {
+        args.append("null"sv);
+    }
+    args.appendff(",{},{},{}", level, base_view_index, num_views);
+    m_context->host_extension_call("OVR_multiview2"sv, "framebufferTextureMultiviewOVR"sv, args.string_view());
+}
+
+void OVRMultiview2::visit_edges(Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_context);
+}
+
+}
