+void WebGLRenderingContextBase::lose_context_via_extension()
+{
+    // Losing a lost context is an INVALID_OPERATION (Chrome).
+    if (m_context_lost) {
+        if (m_error == GL_NO_ERROR)
+            m_error = GL_INVALID_OPERATION;
+        return;
+    }
+    m_lost_via_extension = true;
+    lose_context_from_compositor_loss();
+}
+
+void WebGLRenderingContextBase::restore_context_via_extension()
+{
+    // "If the context was not lost by loseContext, generate an INVALID_OPERATION error."
+    if (!m_context_lost || !m_lost_via_extension) {
+        if (m_error == GL_NO_ERROR)
+            m_error = GL_INVALID_OPERATION;
+        return;
+    }
+    HTML::queue_a_task(HTML::Task::Source::WebGL, nullptr, nullptr, GC::create_function(heap(), [this] {
+        if (!m_context_lost || !m_lost_via_extension)
+            return;
+        m_lost_via_extension = false;
+        restore_context_after_compositor_reconnect();
+    }));
+}
