@@ -9,6 +9,18 @@
 #include <AK/Types.h>
 #include <LibCompositing/Forward.h>
 
+// An embedder whose executor is itself WebGL answers the WebGL getters with its host's values, as JSON
+// (LibWeb's WebGLRenderingContextBase::HostQuery). Not a GL ES entry point: only such an embedder provides it.
+// And calls a host extension method: {"e": extension, "m": method, "a": [arguments]}.
+extern "C" void glHostExtensionCallCHITIN(char const* json);
+extern "C" void glHostQueryCHITIN(unsigned int kind, unsigned int object, unsigned int a, unsigned int b, unsigned int c, int buf_size, int* length, char* json);
+
+#ifdef AK_OS_EMSCRIPTEN
+#    define COMPOSITING_WEBGL_HOST_OVERRIDE(page_value, host_value) (page_value)
+#else
+#    define COMPOSITING_WEBGL_HOST_OVERRIDE(page_value, host_value) (host_value)
+#endif
+
 namespace Compositing::WebGL {
 
 using GLenum = unsigned int;
