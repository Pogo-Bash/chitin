+bool WebGLRenderingContextBase::executor_is_webgl()
+{
+    return !context().host_webgl_extensions().is_empty();
+}
+
+template<typename ArrayType, typename T>
+static JS::Value make_typed_array(JS::Realm& realm, JsonArray const& values)
+{
+    Vector<T> data;
+    for (size_t i = 0; i < values.size(); ++i)
+        data.append(static_cast<T>(values.at(i).get_double_with_precision_loss().value_or(0)));
+    auto bytes = MUST(ByteBuffer::copy(data.data(), data.size() * sizeof(T)));
+    auto array_buffer = JS::ArrayBuffer::create(realm, move(bytes));
+    return ArrayType::create(realm, values.size(), array_buffer);
+}
+
+static Optional<JS::Value> host_json_to_value(JS::Realm& realm, JsonValue const& value)
+{
+    auto& vm = realm.vm();
+    if (value.is_null())
+        return JS::js_null();
+    if (value.is_bool())
+        return JS::Value(value.as_bool());
+    if (value.is_number())
+        return JS::Value(value.get_double_with_precision_loss().value_or(0));
+    if (value.is_string())
+        return JS::PrimitiveString::create(vm, Utf16String::from_utf8(value.as_string()));
+    if (value.is_array()) {
+        auto const& array = value.as_array();
+        if (array.size() == 2 && array.at(0).is_string() && array.at(1).is_array()) {
+            auto const& type = array.at(0).as_string();
+            auto const& values = array.at(1).as_array();
+            if (type == "Float32Array"sv)
+                return make_typed_array<JS::Float32Array, float>(realm, values);
+            if (type == "Int32Array"sv)
+                return make_typed_array<JS::Int32Array, i32>(realm, values);
+            if (type == "Uint32Array"sv)
+                return make_typed_array<JS::Uint32Array, u32>(realm, values);
+            if (type == "Uint8Array"sv)
+                return make_typed_array<JS::Uint8Array, u8>(realm, values);
+        }
+        GC::RootVector<JS::Value> elements;
+        for (auto const& element : array.values()) {
+            auto converted = host_json_to_value(realm, element);
+            if (!converted.has_value())
+                return {};
+            elements.append(*converted);
+        }
+        return JS::Array::create_from(realm, elements);
+    }
+    if (value.is_object()) {
+        auto const& object = value.as_object();
+        if (object.has("nan"sv))
+            return JS::Value(__builtin_nan(""));
+        if (auto inf = object.get_double_with_precision_loss("inf"sv); inf.has_value())
+            return JS::Value(*inf > 0 ? __builtin_inf() : -__builtin_inf());
+    }
+    return {};
+}
+
+Optional<JS::Value> WebGLRenderingContextBase::host_query(HostQuery kind, u32 object, u32 a, u32 b, u32 c)
+{
+    auto json = host_query_json(kind, object, a, b, c);
+    if (!json.has_value())
+        return {};
+    return host_json_to_value(realm(), *json);
+}
+
+static double json_number(JsonArray const& array, size_t index)
+{
+    return array.at(index).get_double_with_precision_loss().value_or(0);
+}
+
+Optional<Optional<GC::Ref<WebGLActiveInfo>>> WebGLRenderingContextBase::host_query_active_info(HostQuery kind, u32 object, u32 index)
+{
+    auto json = host_query_json(kind, object, index);
+    if (!json.has_value())
+        return {};
+    if (json->is_null())
+        return Optional<GC::Ref<WebGLActiveInfo>> {};
+    auto info = json->is_object() ? json->as_object().get_array("info"sv) : Optional<JsonArray const&> {};
+    if (!info.has_value() || info->size() != 3 || !info->at(0).is_string())
+        return {};
+    return Optional<GC::Ref<WebGLActiveInfo>> { *WebGLActiveInfo::create(realm(), Utf16String::from_utf8(info->at(0).as_string()), static_cast<GLenum>(json_number(*info, 2)), static_cast<GLsizei>(json_number(*info, 1))) };
+}
+
+Optional<GC::Ptr<WebGLShaderPrecisionFormat>> WebGLRenderingContextBase::host_query_precision(u32 shader_type, u32 precision_type)
+{
+    auto json = host_query_json(HostQuery::ShaderPrecisionFormat, 0, shader_type, precision_type);
+    if (!json.has_value())
+        return {};
+    if (json->is_null())
+        return GC::Ptr<WebGLShaderPrecisionFormat> {};
+    auto prec = json->is_object() ? json->as_object().get_array("prec"sv) : Optional<JsonArray const&> {};
+    if (!prec.has_value() || prec->size() != 3)
+        return {};
+    return GC::Ptr<WebGLShaderPrecisionFormat> { WebGLShaderPrecisionFormat::create(realm(), json_number(*prec, 0), json_number(*prec, 1), json_number(*prec, 2)) };
+}
+
+Optional<JsonValue> WebGLRenderingContextBase::host_query_json(HostQuery kind, u32 object, u32 a, u32 b, u32 c)
+{
+    if (m_context_lost || !executor_is_webgl())
+        return {};
+    static constexpr GLsizei buffer_size = 64 * KiB;
+    Vector<GLchar> json;
+    json.resize(buffer_size);
+    GLsizei length = 0;
+    context().host_query_chitin(to_underlying(kind), object, a, b, c, buffer_size, &length, json.data());
+    if (length <= 0 || length >= buffer_size)
+        return {};
+    auto parsed = JsonValue::from_string(StringView { json.data(), static_cast<size_t>(length) });
+    if (parsed.is_error())
+        return {};
+    return parsed.release_value();
+}
+
+void WebGLRenderingContextBase::host_extension_call(StringView extension, StringView method, StringView json_arguments)
+{
+    if (m_context_lost || !executor_is_webgl())
+        return;
+    auto json = ByteString::formatted("{{\"e\":\"{}\",\"m\":\"{}\",\"a\":[{}]}}", extension, method, json_arguments);
+    context().host_extension_call_chitin(json.characters());
+}
+
+Vector<String> WebGLRenderingContextBase::host_extension_strings(StringView extension, StringView method)
+{
+    Vector<String> strings;
+    host_extension_call(extension, method, {});
+    auto result = host_query_json(HostQuery::ExtensionResult, 0, 0);
+    if (!result.has_value() || !result->is_array())
+        return strings;
+    for (auto const& value : result->as_array().values()) {
+        if (value.is_string())
+            strings.append(value.as_string());
+    }
+    return strings;
+}
+
+String WebGLRenderingContextBase::host_translated_shader_source(GC::Ref<WebGLShader> shader)
+{
+    auto handle = shader->handle(this);
+    if (handle.is_error()) {
+        if (m_error == GL_NO_ERROR)
+            m_error = GL_INVALID_OPERATION;
+        return {};
+    }
+    auto result = host_query_json(HostQuery::TranslatedShaderSource, handle.value(), 0);
+    if (!result.has_value() || !result->is_string())
+        return {};
+    return result->as_string();
+}
+
+String WebGLRenderingContextBase::host_json_number(double value)
+{
+    if (__builtin_isnan(value) || __builtin_isinf(value))
+        return "null"_string;
+    return MUST(String::formatted("{}", value));
+}
+
+void WebGLRenderingContextBase::watch_executor_loss()
+{
+    // The proxy owns the transport and this context owns the proxy, so the transport never outlives `this`.
+    context().transport().on_context_loss_change = [this](bool restored) {
+        if (restored)
+            restore_context_after_compositor_reconnect();
+        else
+            lose_context_from_compositor_loss();
+    };
+}
