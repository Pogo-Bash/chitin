From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pogo-bash <pogo-bash@users.noreply.github.com>
Date: Wed, 21 Oct 2026 20:12:02 -0500
Subject: [PATCH 22/23] LibWeb: on Emscripten the end of parsing waits for a
 module script's pending evaluation (the embedder's engine loads and evaluates
 module graphs asynchronously): the next deferred script and DOMContentLoaded
 follow it

---
 Libraries/LibWeb/DOM/Document.cpp             |  7 +++++++
 Libraries/LibWeb/DOM/Document.h               |  9 +++++++++
 Libraries/LibWeb/HTML/Parser/HTMLParser.cpp   |  8 ++++++++
 .../LibWeb/HTML/Scripting/ModuleScript.cpp    | 20 +++++++++++++++++++
 4 files changed, 44 insertions(+)

diff --git a/Libraries/LibWeb/DOM/Document.cpp b/Libraries/LibWeb/DOM/Document.cpp
index e3ae2c502d..cb97984209 100644
--- a/Libraries/LibWeb/DOM/Document.cpp
+++ b/Libraries/LibWeb/DOM/Document.cpp
@@ -5352,6 +5352,13 @@ void Document::set_html_parser_end_state(GC::Ptr<HTML::HTMLParserEndState> state
     m_html_parser_end_state = state;
 }
 
+void Document::end_module_evaluation()
+{
+    VERIFY(m_pending_module_evaluations > 0);
+    --m_pending_module_evaluations;
+    schedule_html_parser_end_check();
+}
+
 void Document::schedule_html_parser_end_check()
 {
     if (m_html_parser_end_state)
diff --git a/Libraries/LibWeb/DOM/Document.h b/Libraries/LibWeb/DOM/Document.h
index 63b63ce7c8..91c61e6c1d 100644
--- a/Libraries/LibWeb/DOM/Document.h
+++ b/Libraries/LibWeb/DOM/Document.h
@@ -836,6 +836,14 @@ public:
 
     void set_html_parser_end_state(GC::Ptr<HTML::HTMLParserEndState>);
     void schedule_html_parser_end_check();
+
+    // An embedder whose JavaScript engine evaluates a module graph asynchronously (it loads the imports itself) has a
+    // module script's evaluation still pending when run() returns. "The end" must not run the next deferred script or
+    // fire DOMContentLoaded until it has settled: a module's code expects the module scripts before it to have run
+    // and registers its DOMContentLoaded listeners while it runs.
+    [[nodiscard]] size_t pending_module_evaluations() const { return m_pending_module_evaluations; }
+    void begin_module_evaluation() { ++m_pending_module_evaluations; }
+    void end_module_evaluation();
     bool has_html_parser_end_state() const { return m_html_parser_end_state != nullptr; }
 
     void add_pending_css_import_rule(Badge<CSS::StyleSheetImport>, NonnullRefPtr<CSS::StyleSheetImport>);
@@ -1841,6 +1849,7 @@ private:
 
     size_t m_number_of_things_delaying_the_load_event { 0 };
     GC::Ptr<HTML::HTMLParserEndState> m_html_parser_end_state;
+    size_t m_pending_module_evaluations { 0 };
 
     // https://html.spec.whatwg.org/multipage/browsing-the-web.html#concept-document-salvageable
     bool m_salvageable { true };
diff --git a/Libraries/LibWeb/HTML/Parser/HTMLParser.cpp b/Libraries/LibWeb/HTML/Parser/HTMLParser.cpp
index 851bb7e418..b9a223b5ed 100644
--- a/Libraries/LibWeb/HTML/Parser/HTMLParser.cpp
+++ b/Libraries/LibWeb/HTML/Parser/HTMLParser.cpp
@@ -714,6 +714,11 @@ void HTMLParserEndState::check_progress()
     case Phase::WaitingForDeferredScripts:
         // 5. While the list of scripts that will execute when the document has finished parsing is not empty:
         while (!m_document->scripts_to_execute_when_parsing_has_finished().is_empty()) {
+            // AD-HOC: A module script an embedder's engine is still evaluating comes before the next one
+            //         (Document::begin_module_evaluation); its settling schedules this check again.
+            if (m_document->pending_module_evaluations() > 0)
+                return;
+
             auto& first_script = *m_document->scripts_to_execute_when_parsing_has_finished().first();
 
             // 1. Spin the event loop until the first script in the list of scripts that will execute when the document has finished parsing
@@ -733,6 +738,9 @@ void HTMLParserEndState::check_progress()
             (void)m_document->scripts_to_execute_when_parsing_has_finished().take_first();
         }
 
+        if (m_document->pending_module_evaluations() > 0)
+            return;
+
         advance_to_dom_content_loaded_phase();
         return;
 
diff --git a/Libraries/LibWeb/HTML/Scripting/ModuleScript.cpp b/Libraries/LibWeb/HTML/Scripting/ModuleScript.cpp
index 7ef9a2e1bd..99381949a8 100644
--- a/Libraries/LibWeb/HTML/Scripting/ModuleScript.cpp
+++ b/Libraries/LibWeb/HTML/Scripting/ModuleScript.cpp
@@ -6,8 +6,10 @@
 
 #include <LibGC/Heap.h>
 #include <LibJS/Runtime/ModuleRequest.h>
+#include <LibJS/Runtime/Promise.h>
 #include <LibJS/ScriptCompilation.h>
 #include <LibWeb/CSS/StyleSheetState.h>
+#include <LibWeb/DOM/Document.h>
 #include <LibWeb/HTML/Scripting/Environments.h>
 #include <LibWeb/HTML/Scripting/Fetching.h>
 #include <LibWeb/HTML/Scripting/ModuleScript.h>
@@ -347,6 +349,24 @@ GC::Ptr<WebIDL::Promise> ModuleScript::run(PreventErrorReporting prevent_error_r
         stack.deallocate(stack_mark);
     }
 
+#ifdef AK_OS_EMSCRIPTEN
+    // The embedder's engine loads and evaluates the module graph on its own time: the promise is still pending here,
+    // where a graph with no top-level await has run by now in LibJS. Hold "the end" of the parser until it settles.
+    if (auto document = settings.responsible_document(); document && evaluation_promise
+        && as<JS::Promise>(*evaluation_promise->promise()).state() == JS::Promise::State::Pending) {
+        document->begin_module_evaluation();
+        WebIDL::react_to_promise(*evaluation_promise,
+            GC::create_function(GC::Heap::the(), [document](JS::Value) -> WebIDL::ExceptionOr<JS::Value> {
+                document->end_module_evaluation();
+                return JS::js_undefined();
+            }),
+            GC::create_function(GC::Heap::the(), [document](JS::Value) -> WebIDL::ExceptionOr<JS::Value> {
+                document->end_module_evaluation();
+                return JS::js_undefined();
+            }));
+    }
+#endif
+
     // 8. If preventErrorReporting is false, then upon rejection of evaluationPromise with reason, report the exception given by reason for script.
     if (prevent_error_reporting == PreventErrorReporting::No) {
         HTML::TemporaryExecutionContext execution_context { realm, HTML::TemporaryExecutionContext::CallbacksEnabled::Yes };
