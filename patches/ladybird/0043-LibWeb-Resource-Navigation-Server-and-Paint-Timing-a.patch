+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <LibWeb/PerformanceTimeline/PerformanceEntry.h>
+
+namespace Web::PerformanceTimeline {
+
+// Entry types of the registry (https://w3c.github.io/timing-entrytypes-registry/#registry) that an observer may ask for and
+// a page may look up, as in Blink, but of which no entries are made yet: their buffers stay empty. The registry's
+// availability and buffer size per type.
+template<AvailableFromTimeline available, u64 buffer_size>
+struct UnreportedEntryType {
+    static AvailableFromTimeline available_from_timeline() { return available; }
+    static Optional<u64> max_buffer_size() { return buffer_size; }
+};
+
+using ElementTimingEntryType = UnreportedEntryType<AvailableFromTimeline::No, 150>;
+using EventTimingEntryType = UnreportedEntryType<AvailableFromTimeline::No, 150>;
+using FirstInputEntryType = UnreportedEntryType<AvailableFromTimeline::Yes, 1>;
+using InteractionContentfulPaintEntryType = UnreportedEntryType<AvailableFromTimeline::No, 150>;
+using LargestContentfulPaintEntryType = UnreportedEntryType<AvailableFromTimeline::No, 150>;
+using LayoutShiftEntryType = UnreportedEntryType<AvailableFromTimeline::No, 150>;
+using LongAnimationFrameEntryType = UnreportedEntryType<AvailableFromTimeline::No, 200>;
+using LongTaskEntryType = UnreportedEntryType<AvailableFromTimeline::No, 200>;
+using SoftNavigationEntryType = UnreportedEntryType<AvailableFromTimeline::Yes, 50>;
+
+}
