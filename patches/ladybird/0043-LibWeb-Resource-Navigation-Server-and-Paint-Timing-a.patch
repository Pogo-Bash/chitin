 // https://html.spec.whatwg.org/multipage/interaction.html#update-the-visibility-state
+// https://w3c.github.io/paint-timing/#contentful
+// NB: Approximated from the DOM: rendered non-whitespace text, a rendered image with decoded data, a rendered canvas,
+//     video, or svg element. A background image is not looked at.
+static bool has_contentful_paint(Document& document)
+{
+    bool contentful = false;
+    document.for_each_in_subtree([&](Node& node) {
+        if (!node.has_layout_box())
+            return TraversalDecision::Continue;
+        if (auto* text = as_if<Text>(node)) {
+            if (!text->data().is_ascii_whitespace())
+                contentful = true;
+        } else if (auto* image = as_if<HTML::HTMLImageElement>(node)) {
+            if (image->decoded_image_data())
+                contentful = true;
+        } else if (is<HTML::HTMLCanvasElement>(node) || is<HTML::HTMLVideoElement>(node) || is<SVG::SVGSVGElement>(node)) {
+            contentful = true;
+        }
+        return contentful ? TraversalDecision::Break : TraversalDecision::Continue;
+    });
+    return contentful;
+}
+
+// https://w3c.github.io/paint-timing/#mark-paint-timing
+void Document::mark_paint_timing(double rendering_time)
+{
+    // NB: Only a document that is its navigable's active document and shows something has paints to report.
+    if (m_previously_reported_paints.first_contentful_paint || !navigable() || !window() || !body())
+        return;
+    // 1. If document's previously reported paints contains "first-contentful-paint", then return.
+    // 2. Let paintTimestamp be the rendering update's time (relative to document's time origin).
+    auto paint_timestamp = HighResolutionTime::relative_high_resolution_time(rendering_time, relevant_global_object(*this));
+    auto report = [&](Utf16String const& name) {
+        // https://w3c.github.io/paint-timing/#report-paint-timing
+        auto entry = PaintTiming::PerformancePaintTiming::create(name, max(0.0, paint_timestamp));
+        window()->queue_performance_entry(entry);
+        window()->add_performance_entry(entry);
+    };
+    // 3. Let reportedPaints be document's previously reported paints.
+    // 4-5. If reportedPaints does not contain "first-paint" and the user agent painted something that is not the
+    //      default background (NB: any rendered content, or a body that is rendered at all): report first-paint.
+    // 6-7. If document should report first contentful paint: report first-paint first if it was not, then FCP.
+    bool contentful = has_contentful_paint(*this);
+    if (!m_previously_reported_paints.first_paint && (contentful || body()->has_layout_box())) {
+        // INTEROP: Blink reports first-paint with the first frame that has content; a frame with only a body box is
+        //          the default background to it.
+        if (contentful) {
+            m_previously_reported_paints.first_paint = true;
+            report("first-paint"_utf16);
+        }
+    }
+    if (contentful) {
+        m_previously_reported_paints.first_contentful_paint = true;
+        report("first-contentful-paint"_utf16);
+    }
+}
+
+void Document::reset_default_timeline()
+{
+    if (m_default_timeline)
+        m_default_timeline->reset_for_new_time_origin();
+}
+
+void Document::queue_initial_visibility_state_entry()
+{
+    HTML::VisibilityStateEntry::queue(*this, (m_visibility_state == HTML::VisibilityState::Visible ? "visible"_utf16 : "hidden"_utf16), 0);
+}
