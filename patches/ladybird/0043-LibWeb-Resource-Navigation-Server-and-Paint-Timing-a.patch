+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibWeb/DOM/Document.h>
+#include <LibWeb/HTML/VisibilityStateEntry.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/PerformanceTimeline/EntryTypes.h>
+
+namespace Web::HTML {
+
+GC_DEFINE_ALLOCATOR(VisibilityStateEntry);
+
+GC::Ref<VisibilityStateEntry> VisibilityStateEntry::create(Utf16String const& state, HighResolutionTime::DOMHighResTimeStamp start_time)
+{
+    return GC::Heap::the().allocate<VisibilityStateEntry>(state, start_time);
+}
+
+VisibilityStateEntry::VisibilityStateEntry(Utf16String const& state, HighResolutionTime::DOMHighResTimeStamp start_time)
+    : PerformanceTimeline::PerformanceEntry(state, start_time, 0)
+{
+}
+
+VisibilityStateEntry::~VisibilityStateEntry() = default;
+
+Utf16FlyString const& VisibilityStateEntry::entry_type() const
+{
+    return PerformanceTimeline::EntryTypes::visibility_state;
+}
+
+// https://html.spec.whatwg.org/multipage/interaction.html#queue-a-visibility-state-entry
+void VisibilityStateEntry::queue(DOM::Document& document, Utf16String const& state, HighResolutionTime::DOMHighResTimeStamp timestamp)
+{
+    // 1. Let entry be a new VisibilityStateEntry with name state, startTime timestamp (relative to the time origin).
+    auto window = document.window();
+    if (!window)
+        return;
+    auto entry = create(state, timestamp);
+    // 2. Queue entry.
+    window->queue_performance_entry(entry);
+    // AD-HOC: Also buffered, so getEntriesByType("visibility-state") and buffered observers see it, as in Blink.
+    window->add_performance_entry(entry);
+}
+
+}
