 // This implements the parallel steps of the pullAlgorithm in HTTP-network-fetch.
 // https://fetch.spec.whatwg.org/#ref-for-in-parallel⑤
+void FetchedDataReceiver::set_response_body_sizes(u64 encoded_size)
+{
+    if (!m_response)
+        return;
+    auto body_info = m_response->body_info();
+    // A server that sends no content coding sends the decoded bytes: with no count from the network, the encoded size
+    // is the decoded size.
+    body_info.encoded_size = encoded_size != 0 ? encoded_size : m_decoded_size;
+    body_info.decoded_size = m_decoded_size;
+    // https://fetch.spec.whatwg.org/#ref-for-response-body-info-content-encoding: the coding when there is exactly one
+    // and it is one the user agent supports, otherwise the empty string.
+    if (auto codings = m_response->header_list()->get_decode_and_split("Content-Encoding"sv); codings.has_value() && codings->size() == 1) {
+        auto coding = codings->first().to_ascii_lowercase();
+        if (coding.is_one_of("gzip"sv, "deflate"sv, "br"sv, "zstd"sv))
+            body_info.content_encoding = Utf16String::from_utf8(coding);
+    }
+    m_response->set_body_info(move(body_info));
+}
+
 void FetchedDataReceiver::handle_network_data(JS::Realm& realm, Requests::ResponseData data, NetworkState state)
 {
+    m_decoded_size += data.bytes().size();
     if (state == NetworkState::Complete) {
         VERIFY(data.bytes().is_empty());
         m_network_complete = true;
