diff --git a/Libraries/LibWeb/ServerTiming/PerformanceServerTiming.cpp b/Libraries/LibWeb/ServerTiming/PerformanceServerTiming.cpp
new file mode 100644
index 0000000000..67834d267c
--- /dev/null
+++ b/Libraries/LibWeb/ServerTiming/PerformanceServerTiming.cpp
@@ -0,0 +1,119 @@
+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/CharacterTypes.h>
+#include <AK/GenericLexer.h>
+#include <AK/StringBuilder.h>
+#include <LibGC/Heap.h>
+#include <LibWeb/ServerTiming/PerformanceServerTiming.h>
+
+namespace Web::ServerTiming {
+
+GC_DEFINE_ALLOCATOR(PerformanceServerTiming);
+
+GC::Ref<PerformanceServerTiming> PerformanceServerTiming::create(String name, HighResolutionTime::DOMHighResTimeStamp duration, String description)
+{
+    return GC::Heap::the().allocate<PerformanceServerTiming>(move(name), duration, move(description));
+}
+
+PerformanceServerTiming::PerformanceServerTiming(String name, HighResolutionTime::DOMHighResTimeStamp duration, String description)
+    : m_name(move(name))
+    , m_duration(duration)
+    , m_description(move(description))
+{
+}
+
+PerformanceServerTiming::~PerformanceServerTiming() = default;
+
+static bool is_token_character(u32 c)
+{
+    // https://httpwg.org/specs/rfc9110.html#tokens
+    return is_ascii_alphanumeric(c) || "!#$%&'*+-.^_`|~"sv.contains(static_cast<char>(c));
+}
+
+static void skip_ows(GenericLexer& lexer)
+{
+    lexer.ignore_while([](char c) { return c == ' ' || c == '\t'; });
+}
+
+static StringView consume_token(GenericLexer& lexer)
+{
+    return lexer.consume_while([](char c) { return is_token_character(static_cast<u8>(c)); });
+}
+
+// token / quoted-string; a malformed value is empty.
+static Optional<String> consume_value(GenericLexer& lexer)
+{
+    if (lexer.next_is('"')) {
+        lexer.ignore();
+        StringBuilder builder;
+        while (!lexer.is_eof()) {
+            char c = lexer.consume();
+            if (c == '"')
+                return MUST(builder.to_string());
+            if (c == '\\') {
+                if (lexer.is_eof())
+                    return {};
+                c = lexer.consume();
+            }
+            builder.append(c);
+        }
+        return {};
+    }
+    return MUST(String::from_utf8(consume_token(lexer)));
+}
+
+// https://w3c.github.io/server-timing/#dfn-server-timing-header-parsing-algorithm
+// The header's grammar: #server-timing-metric, server-timing-metric = metric-name *( OWS ";" OWS server-timing-param ),
+// server-timing-param = server-timing-param-name OWS "=" OWS server-timing-param-value. The first "dur" and the first
+// "desc" of a metric count; a metric whose name is not a token is skipped, as the rest of its list entry.
+Vector<GC::Ref<PerformanceServerTiming>> PerformanceServerTiming::parse_header_values(Vector<String> const& values)
+{
+    Vector<GC::Ref<PerformanceServerTiming>> metrics;
+    for (auto const& value : values) {
+        GenericLexer lexer { value.bytes_as_string_view() };
+        while (!lexer.is_eof()) {
+            skip_ows(lexer);
+            auto name = consume_token(lexer);
+            bool ok = !name.is_empty();
+            Optional<double> duration;
+            Optional<String> description;
+            while (ok) {
+                skip_ows(lexer);
+                if (!lexer.next_is(';'))
+                    break;
+                lexer.ignore();
+                skip_ows(lexer);
+                auto param = consume_token(lexer);
+                skip_ows(lexer);
+                Optional<String> param_value;
+                if (lexer.next_is('=')) {
+                    lexer.ignore();
+                    skip_ows(lexer);
+                    param_value = consume_value(lexer);
+                }
+                if (param.equals_ignoring_ascii_case("dur"sv) && !duration.has_value()) {
+                    duration = param_value.has_value() ? param_value->to_number<double>(TrimWhitespace::No).value_or(0) : 0;
+                } else if (param.equals_ignoring_ascii_case("desc"sv) && !description.has_value()) {
+                    description = param_value.value_or({});
+                }
+            }
+            skip_ows(lexer);
+            if (!lexer.is_eof() && !lexer.next_is(',')) {
+                // Not a well-formed metric: drop the rest of this entry.
+                ok = false;
+                lexer.ignore_until(',');
+            }
+            if (lexer.next_is(','))
+                lexer.ignore();
+            if (ok)
+                metrics.append(create(MUST(String::from_utf8(name)), duration.value_or(0), description.value_or({})));
+        }
+    }
+    return metrics;
+}
+
+}
