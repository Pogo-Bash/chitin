+    HTML::VisibilityStateEntry::queue(*this, (visibility_state == HTML::VisibilityState::Visible ? "visible"_utf16 : "hidden"_utf16), HighResolutionTime::current_high_resolution_time(relevant_global_object(*this)));
 
     // FIXME: 4. Run the screen orientation change steps with document.
 
