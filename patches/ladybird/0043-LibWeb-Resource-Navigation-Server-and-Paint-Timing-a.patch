+/*
+ * Copyright (c) 2026-present, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/PerformanceTimeline/PerformanceEntry.h>
+
+namespace Web::PaintTiming {
+
+// https://w3c.github.io/paint-timing/#sec-PerformancePaintTiming
+class PerformancePaintTiming final : public PerformanceTimeline::PerformanceEntry {
+    WEB_WRAPPABLE(PerformancePaintTiming, PerformanceTimeline::PerformanceEntry);
+    GC_DECLARE_ALLOCATOR(PerformancePaintTiming);
+
+public:
+    virtual ~PerformancePaintTiming() override;
+
+    // name is "first-paint" or "first-contentful-paint"; paint_time is relative to the time origin.
+    [[nodiscard]] static GC::Ref<PerformancePaintTiming> create(Utf16String const& name, HighResolutionTime::DOMHighResTimeStamp paint_time);
+
+    // https://w3c.github.io/timing-entrytypes-registry/#registry
+    static PerformanceTimeline::AvailableFromTimeline available_from_timeline() { return PerformanceTimeline::AvailableFromTimeline::Yes; }
+    static Optional<u64> max_buffer_size() { return 2; }
+    virtual PerformanceTimeline::ShouldAddEntry should_add_entry(Optional<PerformanceTimeline::PerformanceObserverInit const&> = {}) const override { return PerformanceTimeline::ShouldAddEntry::Yes; }
+
+    virtual Utf16FlyString const& entry_type() const override;
+
+    HighResolutionTime::DOMHighResTimeStamp paint_time() const { return m_paint_time; }
+    // The engine presents a frame when it paints it: the presentation time is the paint time.
+    Optional<HighResolutionTime::DOMHighResTimeStamp> presentation_time() const { return m_paint_time; }
+
+private:
+    PerformancePaintTiming(Utf16String const& name, HighResolutionTime::DOMHighResTimeStamp paint_time);
+
+    HighResolutionTime::DOMHighResTimeStamp m_paint_time { 0 };
+};
+
+}
