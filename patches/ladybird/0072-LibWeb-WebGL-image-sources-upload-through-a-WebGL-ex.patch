diff --git a/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp b/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
index 6a8b4d29cc..854be51eaa 100644
--- a/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
+++ b/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
@@ -368,17 +368,23 @@ Optional<WebGLRenderingContextBase::TexImageSourceFrame> WebGLRenderingContextBa
 
     // Validate the combination before recording; the pixels travel to the host as shared
     // memory and the host performs the conversion next to GL.
-    if (!texture_export_format(format, type).has_value())
+    // A WebGL executor converts with the host's own upload (every format and type WebGL takes; the host validates).
+    if (!executor_is_webgl() && !texture_export_format(format, type).has_value())
         return OptionalNone {};
 
     // FIXME: Respect unpackColorSpace
+    auto bitmap_is_premultiplied = frame->bitmap().alpha_type() == Gfx::AlphaType::Premultiplied;
     return TexImageSourceFrame {
         .frame = frame.release_value(),
         // The first pixel transferred from the source to the WebGL implementation corresponds to the upper left corner of
         // the source. This behavior is modified by the UNPACK_FLIP_Y_WEBGL pixel storage parameter, except for ImageBitmap
         // arguments, as described in the abovementioned section.
         .flip_y = m_unpack_flip_y && !source.has<GC::Ref<HTML::ImageBitmap>>(),
-        .premultiply_alpha = m_unpack_premultiply_alpha,
+        // UNPACK_PREMULTIPLY_ALPHA_WEBGL is ignored for an ImageBitmap: its pixels go up as the bitmap holds them
+        // (premultiplied or not, as its premultiplyAlpha option made them).
+        .premultiply_alpha = source.has<GC::Ref<HTML::ImageBitmap>>()
+            ? bitmap_is_premultiplied
+            : m_unpack_premultiply_alpha,
     };
 }
 
diff --git a/Libraries/LibWeb/WebGL/WebGLRenderingContextImpl.cpp b/Libraries/LibWeb/WebGL/WebGLRenderingContextImpl.cpp
index 19c6006345..c62b04334c 100644
