     });
 }
 
-static ErrorOr<Gfx::BitmapExportResult> convert_bitmap_for_upload(Vector<Gfx::DecodedImageFrame> const& bitmaps, u32 bitmap_index, GLenum format, GLenum type, bool has_explicit_destination_size, GLsizei destination_width, GLsizei destination_height, bool flip_y, bool premultiply_alpha)
+#ifdef AK_OS_EMSCRIPTEN
+// The frame's pixels, top row first, as unpremultiplied RGBA8.
+static ErrorOr<ByteBuffer> unpremultiplied_rgba8(Gfx::Bitmap const& bitmap)
+{
+    auto width = bitmap.width();
+    auto height = bitmap.height();
+    auto buffer = TRY(ByteBuffer::create_uninitialized(static_cast<size_t>(width) * height * 4));
+    auto premultiplied = bitmap.alpha_type() == Gfx::AlphaType::Premultiplied;
+    auto* out = buffer.data();
+    for (int y = 0; y < height; ++y) {
+        for (int x = 0; x < width; ++x, out += 4) {
+            auto pixel = bitmap.get_pixel(x, y);
+            u8 r = pixel.red(), g = pixel.green(), b = pixel.blue(), a = pixel.alpha();
+            if (bitmap.format() == Gfx::BitmapFormat::BGRx8888 || bitmap.format() == Gfx::BitmapFormat::RGBx8888)
+                a = 255;
+            if (premultiplied && a != 255) {
+                auto unpremultiply = [a](u8 c) -> u8 { return a ? static_cast<u8>(min(255u, (c * 255u + a / 2) / a)) : 0; };
+                r = unpremultiply(r);
+                g = unpremultiply(g);
+                b = unpremultiply(b);
+            }
+            out[0] = r;
+            out[1] = g;
+            out[2] = b;
+            out[3] = a;
+        }
+    }
+    return buffer;
+}
+
+static ErrorOr<void> upload_through_host(int call, Vector<Gfx::DecodedImageFrame> const& bitmaps, u32 bitmap_index, unsigned target, int level, int internalformat,
+    int xoffset, int yoffset, int zoffset, bool has_explicit_destination_size, int width, int height, int depth, unsigned format, unsigned type, bool flip_y, bool premultiply_alpha)
+{
+    if (bitmap_index >= bitmaps.size())
+        return Error::from_string_literal("WebGL image upload references an out-of-range bitmap");
+    auto const& bitmap = bitmaps[bitmap_index].bitmap();
+    auto rgba = TRY(unpremultiplied_rgba8(bitmap));
+    if (!has_explicit_destination_size)
+        width = height = -1;
+    ganglion_host_webgl_tex_source(call, target, level, internalformat, xoffset, yoffset, zoffset, width, height, depth, format, type, rgba.data(),
+        bitmap.width(), bitmap.height(), flip_y, premultiply_alpha);
+    return {};
+}
+#endif
+
+[[maybe_unused]] static ErrorOr<Gfx::BitmapExportResult> convert_bitmap_for_upload(Vector<Gfx::DecodedImageFrame> const& bitmaps, u32 bitmap_index, GLenum format, GLenum type, bool has_explicit_destination_size, GLsizei destination_width, GLsizei destination_height, bool flip_y, bool premultiply_alpha)
 {
     if (bitmap_index >= bitmaps.size())
         return Error::from_string_literal("WebGL image upload references an out-of-range bitmap");
@@ -126,6 +177,10 @@ static ErrorOr<Gfx::BitmapExportResult> convert_bitmap_for_upload(Vector<Gfx::De
 
