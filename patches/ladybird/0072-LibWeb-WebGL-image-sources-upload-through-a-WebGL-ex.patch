diff --git a/Libraries/LibWeb/HTML/WindowOrWorkerGlobalScope.cpp b/Libraries/LibWeb/HTML/WindowOrWorkerGlobalScope.cpp
index cfae4731fc..e1726d7894 100644
--- a/Libraries/LibWeb/HTML/WindowOrWorkerGlobalScope.cpp
+++ b/Libraries/LibWeb/HTML/WindowOrWorkerGlobalScope.cpp
@@ -43,6 +43,7 @@
 #include <LibWeb/HTML/EventLoop/EventLoop.h>
 #include <LibWeb/HTML/EventSource.h>
 #include <LibWeb/HTML/HTMLImageElement.h>
+#include <LibWeb/HTML/HTMLVideoElement.h>
 #include <LibWeb/HTML/LocalNavigable.h>
 #include <LibWeb/HTML/OffscreenCanvas.h>
 #include <LibWeb/HTML/PromiseRejectionEvent.h>
@@ -413,11 +414,42 @@ static ErrorOr<NonnullRefPtr<Gfx::Bitmap>> crop_to_the_source_rectangle_with_for
         output = TRY(scale_bitmap(compositor_host, *output, size, scaling_pass.mode));
     }
 
-    // FIXME: 8. If the value of the imageOrientation member of options is "flipY", output must be flipped vertically,
+    // 8. If the value of the imageOrientation member of options is "flipY", output must be flipped vertically,
     //  disregarding any image orientation metadata of the source (such as EXIF metadata), if any. [EXIF]
+    // 10. Let val be the value of premultiplyAlpha member of options: "premultiply" -> the color channels of output
+    //  are premultiplied by its alpha; "none" -> they are not; "default" -> implementation-specific (premultiplied, as
+    //  in Chrome).
+    // NOTE: Both are done in one pass over the pixels; the format stays the input's, only the alpha type may change.
+    auto flip = options.image_orientation == Bindings::ImageOrientation::FlipY;
+    auto alpha_type = options.premultiply_alpha == Bindings::PremultiplyAlpha::None ? Gfx::AlphaType::Unpremultiplied : Gfx::AlphaType::Premultiplied;
+    if (flip || alpha_type != output->alpha_type()) {
+        auto converted = TRY(Gfx::Bitmap::create(output->format(), alpha_type, output->size()));
+        auto has_alpha = output->format() == Gfx::BitmapFormat::BGRA8888 || output->format() == Gfx::BitmapFormat::RGBA8888;
+        auto unpremultiply = has_alpha && output->alpha_type() == Gfx::AlphaType::Premultiplied && alpha_type == Gfx::AlphaType::Unpremultiplied;
+        auto premultiply = has_alpha && output->alpha_type() == Gfx::AlphaType::Unpremultiplied && alpha_type == Gfx::AlphaType::Premultiplied;
+        for (int y = 0; y < output->height(); ++y) {
+            auto* source_row = output->scanline(y);
+            auto* target_row = converted->scanline(flip ? output->height() - 1 - y : y);
+            for (int x = 0; x < output->width(); ++x) {
+                u32 pixel = source_row[x];
+                u32 a = pixel >> 24;
+                if ((unpremultiply || premultiply) && a != 255) {
+                    // Every format here keeps alpha in the top byte and the colour channels in the three below.
+                    u32 result = pixel & 0xff000000;
+                    for (int shift = 0; shift < 24; shift += 8) {
+                        u32 c = (pixel >> shift) & 0xff;
+                        c = unpremultiply ? (a ? min(255u, (c * 255 + a / 2) / a) : 0) : (c * a + 127) / 255;
+                        result |= c << shift;
+                    }
+                    pixel = result;
+                }
+                target_row[x] = pixel;
+            }
+        }
+        output = move(converted);
+    }
     // FIXME: 9. If image is an img element or a Blob object, let val be the value of the colorSpaceConversion member
     //  of options, and then run these substeps:
-    // FIXME: 10. Let val be the value of premultiplyAlpha member of options, and then run these substeps:
 
     // 11. Return output.
     return output;
@@ -613,11 +645,30 @@ void WindowOrWorkerGlobalScopeMixin::create_image_bitmap_impl(JS::Realm& realm,
                     }));
                 },
                 // -> video
-                [&](GC::Ref<HTMLVideoElement>) {
-                    dbgln("(STUBBED) createImageBitmap() for HTMLVideoElement");
-                    auto const error = JS::Error::create(realm, "Not Implemented: createImageBitmap() for HTMLVideoElement"sv);
-                    TemporaryExecutionContext const context { WebIDL::promise_realm(*p), TemporaryExecutionContext::CallbacksEnabled::Yes };
-                    WebIDL::reject_promise(*p, error);
+                [&](GC::Ref<HTMLVideoElement> video) {
+                    // 1. If image's networkState attribute is NETWORK_EMPTY, then return a promise rejected with an
+                    //    "InvalidStateError" DOMException. (A video with no current frame is rejected the same way.)
+                    auto frame = video->current_decoded_image_frame();
+                    if (video->network_state() == HTMLMediaElement::NetworkState::Empty || !frame.has_value()) {
+                        WebIDL::reject_promise(*p, WebIDL::InvalidStateError::create("The video has no current frame"_utf16));
+                        return;
+                    }
+                    // 2. Set imageBitmap's bitmap data to a copy of the frame at the current playback position, at the
+                    //    media resource's natural width and natural height, cropped to the source rectangle with formatting.
+                    RefPtr<Gfx::Bitmap const> frame_bitmap = &frame->bitmap();
+                    auto cropped_bitmap_or_error = crop_to_the_source_rectangle_with_formatting(compositor_host_for(realm.global_object()), frame_bitmap, sx, sy, sw, sh, options);
+                    if (cropped_bitmap_or_error.is_error()) {
+                        WebIDL::reject_promise(*p, WebIDL::InvalidStateError::create("Image size is invalid"_utf16));
+                        return;
+                    }
+                    image_bitmap->set_bitmap(cropped_bitmap_or_error.release_value());
+
+                    // 3. Queue a global task, using the bitmap task source, to resolve promise with imageBitmap.
+                    queue_global_task(Task::Source::BitmapTask, realm.global_object(), GC::create_function(GC::Heap::the(), [p, image_bitmap] {
+                        auto& realm = WebIDL::promise_realm(*p);
+                        TemporaryExecutionContext const context { realm, TemporaryExecutionContext::CallbacksEnabled::Yes };
+                        Bindings::resolve_image_bitmap_promise(realm, *p, image_bitmap);
+                    }));
                 },
                 // -> img
                 // -> SVG image
