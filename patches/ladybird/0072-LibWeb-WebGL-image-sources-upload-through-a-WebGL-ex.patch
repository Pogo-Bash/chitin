     auto handle = buffer_handle.value();
     m_context->delete_buffers(1, &handle);
+
+    // Deleting a bound buffer resets every binding to it in this context (GLES 3.0 2.10.1, WebGL 2 5.1).
+    for (auto* binding : { &m_array_buffer_binding, &m_element_array_buffer_binding, &m_uniform_buffer_binding, &m_copy_read_buffer_binding,
+             &m_copy_write_buffer_binding, &m_transform_feedback_buffer_binding, &m_pixel_pack_buffer_binding, &m_pixel_unpack_buffer_binding }) {
+        if (*binding == buffer)
+            *binding = nullptr;
+    }
+    for (auto& indexed : m_indexed_buffer_bindings) {
+        if (indexed.value == buffer)
+            indexed.value = nullptr;
+    }
 }
 
