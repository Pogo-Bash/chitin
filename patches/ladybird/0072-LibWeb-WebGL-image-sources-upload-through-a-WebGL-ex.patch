 // An embedder whose GL is WebGL keeps the page's UNPACK_FLIP_Y / PREMULTIPLY state on its host context, where it
 // applies to array uploads; image uploads are converted here, so the embedder sets that state aside around them.
 extern "C" void ganglion_host_webgl_bitmap_upload(int begin);
+// Such an embedder uploads image sources itself: the source's pixels as unpremultiplied RGBA8 go to the host's own
+// texImage2D/texSubImage2D/texImage3D/texSubImage3D taking an ImageData, which converts them to the format and type
+// (every one WebGL takes), flips and premultiplies as the flags say, and applies the unpack sub-rectangle, as the host
+// does for a page. call: 0 texImage2D, 1 texSubImage2D, 2 texImage3D, 3 texSubImage3D; width < 0: the source's size.
+extern "C" void ganglion_host_webgl_tex_source(int call, unsigned target, int level, int internalformat, int xoffset, int yoffset, int zoffset,
+    int width, int height, int depth, unsigned format, unsigned type, u8 const* rgba, int source_width, int source_height, int flip_y, int premultiply_alpha);
 #endif
 
