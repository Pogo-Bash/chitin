diff --git a/Libraries/LibMedia/Audio/NullPlaybackStream.h b/Libraries/LibMedia/Audio/NullPlaybackStream.h
index d9555d3d54..89d27392ca 100644
--- a/Libraries/LibMedia/Audio/NullPlaybackStream.h
+++ b/Libraries/LibMedia/Audio/NullPlaybackStream.h
@@ -10,6 +10,21 @@
 
 namespace Audio {
 
+#ifdef AK_OS_EMSCRIPTEN
+// Where an embedder that plays audio itself (a page in a browser) takes the null stream's output: open() returns a
+// nonzero stream id for a stream at that rate and channel count, write() gets each period pulled (interleaved floats),
+// control() whether the stream is playing and its volume, close() its end. sample_rate is the rate streams created
+// afterwards run at (the embedder's output rate), 0 for the default.
+struct EmbedderAudioOutput {
+    u32 sample_rate { 0 };
+    u32 (*open)(u32 sample_rate, u32 channel_count) { nullptr };
+    void (*write)(u32 stream, float const* interleaved_samples, size_t frame_count) { nullptr };
+    void (*control)(u32 stream, bool playing, double volume) { nullptr };
+    void (*close)(u32 stream) { nullptr };
+};
+MEDIA_API void set_embedder_audio_output(EmbedderAudioOutput const*);
+#endif
+
 // A virtual audio output device which pulls audio at wall-clock pace and discards it. This keeps media pipelines
 // running without requiring an audio server or hardware output device.
 class MEDIA_API NullPlaybackStream final : public PlaybackStream {
