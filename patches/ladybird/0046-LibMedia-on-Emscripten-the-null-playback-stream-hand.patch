+
+#ifdef AK_OS_EMSCRIPTEN
+// The embedder's output (a page in a browser plays what it is handed): the null stream keeps its wall-clock pace and
+// its pull loop, and hands each period it pulled to the embedder instead of discarding it.
+static EmbedderAudioOutput const* s_embedder_output = nullptr;
+
+void set_embedder_audio_output(EmbedderAudioOutput const* output)
+{
+    s_embedder_output = output;
+}
+
+static u32 output_sample_rate()
+{
+    if (s_embedder_output && s_embedder_output->sample_rate >= 8000 && s_embedder_output->sample_rate <= 384000)
+        return s_embedder_output->sample_rate;
+    return 44100;
+}
+#else
+static constexpr u32 output_sample_rate() { return 44100; }
+#endif
+
+static i64 period_frames() { return static_cast<i64>(output_sample_rate()) * PERIOD_MS / 1000; }
 
