From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pogo-bash <pogo-bash@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:35:11 -0500
Subject: [PATCH] LibWeb: WebGL getExtension on a lost context is null; WebGL 1
 null uploads go to a WebGL executor as null

---
 Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp      | 3 +++
 Libraries/LibWeb/WebGL/WebGLRenderingContextOverloads.cpp | 8 ++++++++
 2 files changed, 11 insertions(+)

diff --git a/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp b/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
index c302008df4..a6bd709830 100644
--- a/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
+++ b/Libraries/LibWeb/WebGL/WebGLRenderingContextBase.cpp
@@ -239,6 +239,9 @@ GC::Ptr<JS::Object> WebGLRenderingContextBase::get_extension(JS::Realm& caller_r
 
     auto name_string = MUST(String::from_byte_string(name.to_byte_string()));
     auto supported_extensions = get_supported_extensions();
+    // A lost context supports no extensions: getExtension returns null (getSupportedExtensions returns null).
+    if (!supported_extensions.has_value())
+        return nullptr;
     auto supported_extension_iterator = supported_extensions->find_if([&name](Utf16String const& supported_extension) {
         return supported_extension.equals_ignoring_ascii_case(name);
     });
diff --git a/Libraries/LibWeb/WebGL/WebGLRenderingContextOverloads.cpp b/Libraries/LibWeb/WebGL/WebGLRenderingContextOverloads.cpp
index 3c5507f04d..c2b89d7fe4 100644
--- a/Libraries/LibWeb/WebGL/WebGLRenderingContextOverloads.cpp
+++ b/Libraries/LibWeb/WebGL/WebGLRenderingContextOverloads.cpp
@@ -142,6 +142,14 @@ void WebGLRenderingContextOverloads::tex_image2d(WebIDL::UnsignedLong target, We
         return;
     }
 
+    // An executor that is itself a WebGL implementation zero-fills a null upload (as WebGL 2 here does) and validates
+    // the format and type itself, the extensions' ones included (float, half float, sRGB, depth). No zeroed copy: at
+    // the largest texture sizes it did not fit the engine's memory and stopped it.
+    if (executor_is_webgl()) {
+        m_context->tex_image2d_robust_angle(target, level, internalformat, width, height, border, format, type, 0, nullptr);
+        return;
+    }
+
     Checked<size_t> bytes = 0;
     if (type == GL_UNSIGNED_SHORT_5_6_5 && format != GL_RGB) {
         set_error(GL_INVALID_OPERATION);
