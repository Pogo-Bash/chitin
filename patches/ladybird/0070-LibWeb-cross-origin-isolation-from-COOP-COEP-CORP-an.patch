+EmbedderPolicy obtain_an_embedder_policy(HTTP::HeaderList const& headers, bool secure_context)
+{
+    // 1. Let policy be a new embedder policy.
+    EmbedderPolicy policy;
+
+    // 2. If environment is a non-secure context, then return policy.
+    if (!secure_context)
+        return policy;
+
+    // AD-HOC: The spec gets these headers as structured field items; a token up to any parameters (';') is what decides the
+    //         value (the "report-to" parameter is not read).
+    auto token = [&](StringView name) -> Optional<EmbedderPolicyValue> {
+        auto header = headers.get(name);
+        if (!header.has_value())
+            return {};
+        auto value = header->view();
+        if (auto semicolon = value.find(';'); semicolon.has_value())
+            value = value.substring_view(0, *semicolon);
+        value = value.trim_whitespace();
+        if (value == "require-corp"sv)
+            return EmbedderPolicyValue::RequireCorp;
+        if (value == "credentialless"sv)
+            return EmbedderPolicyValue::Credentialless;
+        return {};
+    };
+
+    // 3. Let parsedItem be the result of getting a structured field value with `Cross-Origin-Embedder-Policy` and "item".
+    // 4. If parsedItem is non-null and contains a supported value, set policy's value to it.
+    if (auto value = token("Cross-Origin-Embedder-Policy"sv); value.has_value())
+        policy.value = *value;
+
+    // 5. The same for `Cross-Origin-Embedder-Policy-Report-Only` and policy's report only value.
+    if (auto value = token("Cross-Origin-Embedder-Policy-Report-Only"sv); value.has_value())
+        policy.report_only_value = *value;
+
+    // 6. Return policy.
+    return policy;
+}
