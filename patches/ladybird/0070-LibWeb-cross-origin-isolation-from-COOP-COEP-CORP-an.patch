 // https://fetch.spec.whatwg.org/#concept-http-fetch
+// https://fetch.spec.whatwg.org/#cross-origin-resource-policy-internal-check
+static bool cross_origin_resource_policy_internal_check_blocks(URL::Origin const& origin, HTML::EmbedderPolicyValue embedder_policy_value, Infrastructure::Response const& response, bool request_mode_is_no_cors, bool for_navigation)
+{
+    // 1. If forNavigation is false and request's mode is not "no-cors", then return allowed.
+    if (!for_navigation && !request_mode_is_no_cors)
+        return false;
+
+    // 2. Let policy be the result of getting `Cross-Origin-Resource-Policy` from response's header list.
+    // 3. If policy is neither `same-origin`, `same-site`, nor `cross-origin`, then set policy to null.
+    auto header = response.header_list()->get("Cross-Origin-Resource-Policy"sv);
+    Optional<StringView> policy;
+    if (header.has_value()) {
+        auto value = header->view().trim_whitespace();
+        if (value.is_one_of("same-origin"sv, "same-site"sv, "cross-origin"sv))
+            policy = value;
+    }
+
+    // 4. If policy is null, then switch on embedderPolicyValue:
+    if (!policy.has_value()) {
+        switch (embedder_policy_value) {
+        case HTML::EmbedderPolicyValue::UnsafeNone:
+            break;
+        case HTML::EmbedderPolicyValue::Credentialless:
+            // Set policy to `same-origin` if response's request-includes-credentials is true, or forNavigation is true.
+            if (response.request_includes_credentials() || for_navigation)
+                policy = "same-origin"sv;
+            break;
+        case HTML::EmbedderPolicyValue::RequireCorp:
+            policy = "same-origin"sv;
+            break;
+        }
+    }
+
+    // 5. Switch on policy:
+    if (!policy.has_value() || *policy == "cross-origin"sv)
+        return false;
+    auto const& url = response.url();
+    if (!url.has_value())
+        return false;
+    auto response_origin = url->origin();
+    if (*policy == "same-origin"sv)
+        return !origin.is_same_origin(response_origin);
+    // "same-site": allowed if origin is schemelessly same site with response's URL's origin and origin's scheme is "https" or
+    // response's URL's scheme is not "https".
+    // AD-HOC: Same site (schemeful) stands in for schemelessly same site.
+    if (origin.is_same_site(response_origin) && (origin.scheme() == "https"sv || url->scheme() != "https"sv))
+        return false;
+    return true;
+}
+
+bool cross_origin_resource_policy_check_blocks(URL::Origin const& origin, HTML::EmbedderPolicy const& embedder_policy, Infrastructure::Response const& response, bool request_mode_is_no_cors, bool for_navigation)
+{
+    // 1. Let embedderPolicy be environment's policy container's embedder policy (given).
+    // 2. If the internal check with origin, "unsafe-none", response, and forNavigation returns blocked, then return blocked.
+    if (cross_origin_resource_policy_internal_check_blocks(origin, HTML::EmbedderPolicyValue::UnsafeNone, response, request_mode_is_no_cors, for_navigation))
+        return true;
+    // 3. FIXME: The report-only check (queue a violation report).
+    // 4. If the internal check with origin, embedderPolicy's value, response, and forNavigation returns blocked, then return blocked.
+    if (cross_origin_resource_policy_internal_check_blocks(origin, embedder_policy.value, response, request_mode_is_no_cors, for_navigation))
+        return true;
+    // 5. Return allowed.
+    return false;
+}
