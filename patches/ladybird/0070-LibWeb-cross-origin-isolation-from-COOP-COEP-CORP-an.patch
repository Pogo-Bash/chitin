+static Optional<bool> s_top_level_cross_origin_isolation_override;
+
+void set_top_level_cross_origin_isolation_override(Optional<bool> value)
+{
+    s_top_level_cross_origin_isolation_override = value;
+}
+
+// https://html.spec.whatwg.org/multipage/iframe-embed-object.html#allowed-to-use, for the "cross-origin-isolated" feature
+// (https://w3c.github.io/webappsec-permissions-policy/, default allowlist 'self').
+// AD-HOC: A permissions policy reduced to this one feature: a frame inherits it when its container's `allow` attribute
+//         allows the frame's origin ('src' or no allowlist: the frame's own, '*', 'self': the container document's, origins),
+//         or, without a declaration, when the frame is same origin with its container document (the default 'self'). The
+//         Permissions-Policy header is not read.
+static bool is_allowed_to_use_cross_origin_isolated(DOM::Document const& document)
+{
+    auto navigable = document.navigable();
+    if (!navigable || !navigable->parent())
+        return true;
+    auto container_document = navigable->container_document();
+    if (!container_document || !is_allowed_to_use_cross_origin_isolated(*container_document))
+        return false;
+    auto const& origin = document.origin();
+    auto container = navigable->container();
+    auto allow_attribute = container ? container->get_attribute(AttributeNames::allow) : Optional<Utf16String> {};
+    if (allow_attribute.has_value()) {
+        auto allow = allow_attribute->to_utf8_but_should_be_ported_to_utf16();
+        for (auto directive : allow.bytes_as_string_view().split_view(';')) {
+            auto parts = directive.split_view_if(is_ascii_space);
+            if (parts.is_empty() || parts[0] != "cross-origin-isolated"sv)
+                continue;
+            if (parts.size() == 1)
+                return true; // 'src'
+            for (size_t i = 1; i < parts.size(); ++i) {
+                auto token = parts[i];
+                if (token == "*"sv || token == "'src'"sv)
+                    return true;
+                if (token == "'self'"sv && origin.is_same_origin(container_document->origin()))
+                    return true;
+                if (auto url = URL::Parser::basic_parse(token); url.has_value() && origin.is_same_origin(url->origin()))
+                    return true;
+            }
+            return false;
+        }
+    }
+    return origin.is_same_origin(container_document->origin());
+}
