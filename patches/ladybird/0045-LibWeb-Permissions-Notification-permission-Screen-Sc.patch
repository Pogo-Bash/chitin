+// https://notifications.spec.whatwg.org/#get-the-notifications-permission-state
+static Bindings::NotificationPermission notifications_permission_state(HTML::EnvironmentSettingsObject& settings)
+{
+    // 1. Let permissionState be the result of getting the current permission state with "notifications" and settings.
+    auto permission_state = PermissionsAPI::get_current_permission_state("notifications"_utf16, settings);
+
+    // 2. If permissionState is "prompt", then return "default".
+    // 3. Return permissionState.
+    switch (permission_state) {
+    case PermissionsAPI::PermissionState::Granted:
+        return Bindings::NotificationPermission::Granted;
+    case PermissionsAPI::PermissionState::Denied:
+        return Bindings::NotificationPermission::Denied;
+    case PermissionsAPI::PermissionState::Prompt:
+        break;
+    }
+    return Bindings::NotificationPermission::Default;
+}
+
+// https://notifications.spec.whatwg.org/#dom-notification-permission
+Bindings::NotificationPermission Notification::permission(JS::VM&)
+{
+    // The static permission getter steps are to return the result of getting the notifications permission state with the
+    // current settings object.
+    return notifications_permission_state(HTML::current_settings_object());
+}
+
+// https://notifications.spec.whatwg.org/#dom-notification-requestpermission
+GC::Ref<WebIDL::Promise> Notification::request_permission(JS::VM&, GC::Ptr<WebIDL::CallbackType> deprecated_callback)
+{
+    // 1. Let global be the current global object.
+    auto& global = HTML::current_global_object();
+    auto& realm = HTML::relevant_realm(global);
+
+    // 2. Let promise be a new promise in this's relevant Realm.
+    auto promise = WebIDL::create_promise(realm);
+
+    // 3. Run these steps in parallel:
+    //    1. Let permissionState be the result of requesting permission to use "notifications".
+    //    NB: Nothing is granted without asking the user, and there is no prompt to ask with: the request is dismissed,
+    //        which leaves the state as it was ("default" for an origin that was never granted or denied).
+    auto permission_state = notifications_permission_state(HTML::current_settings_object());
+
+    //    2. Queue a global task on the DOM manipulation task source given global to run these steps:
+    HTML::queue_global_task(HTML::Task::Source::DOMManipulation, global, GC::create_function(realm.heap(), [&realm, promise, deprecated_callback, permission_state] {
+        HTML::TemporaryExecutionContext context { realm, HTML::TemporaryExecutionContext::CallbacksEnabled::Yes };
+        auto value = JS::PrimitiveString::create(realm.vm(), Bindings::idl_enum_to_string(permission_state));
+        // 1. If deprecatedCallback is given, then invoke deprecatedCallback with « permissionState » and "report".
+        if (deprecated_callback)
+            (void)WebIDL::invoke_callback(*deprecated_callback, {}, WebIDL::ExceptionBehavior::Report, { { value } });
+        // 2. Resolve promise with permissionState.
+        WebIDL::resolve_promise(realm, promise, value);
+    }));
+
+    // 4. Return promise.
+    return promise;
+}
+
 }
