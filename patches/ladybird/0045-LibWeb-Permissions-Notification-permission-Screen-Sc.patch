+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibWeb/DOM/Event.h>
+#include <LibWeb/HTML/EventNames.h>
+#include <LibWeb/HTML/NetworkInformation.h>
+#include <LibWeb/HTML/Window.h>
+#include <LibWeb/Page/Page.h>
+
+namespace Web::HTML {
+
+GC_DEFINE_ALLOCATOR(NetworkInformation);
+
+NetworkInformation::NetworkInformation(Window& window)
+    : DOM::EventTarget()
+    , m_window(window)
+{
+}
+
+GC::Ref<NetworkInformation> NetworkInformation::create(Window& window)
+{
+    return GC::Heap::the().allocate<NetworkInformation>(window);
+}
+
+void NetworkInformation::visit_edges(Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_window);
+}
+
+// https://wicg.github.io/netinfo/#effectivetype-attribute
+EffectiveConnectionType NetworkInformation::effective_type() const
+{
+    auto type = m_window->page().client().network_information().effective_type;
+    if (type == "slow-2g"sv)
+        return EffectiveConnectionType::Slow2g;
+    if (type == "2g"sv)
+        return EffectiveConnectionType::_2g;
+    if (type == "3g"sv)
+        return EffectiveConnectionType::_3g;
+    return EffectiveConnectionType::_4g;
+}
+
+// https://wicg.github.io/netinfo/#rtt-attribute
+double NetworkInformation::rtt() const
+{
+    // The value is rounded to the nearest multiple of 25 milliseconds (NetInfo, "rtt"), as the embedder reports it.
+    return m_window->page().client().network_information().rtt;
+}
+
+// https://wicg.github.io/netinfo/#downlink-attribute
+double NetworkInformation::downlink() const
+{
+    return m_window->page().client().network_information().downlink;
+}
+
+// https://wicg.github.io/netinfo/#savedata-attribute
+bool NetworkInformation::save_data() const
+{
+    return m_window->page().client().network_information().save_data;
+}
+
+void NetworkInformation::set_onchange(GC::Ptr<WebIDL::CallbackType> event_handler)
+{
+    set_event_handler_attribute(EventNames::change, event_handler);
+}
+
+GC::Ptr<WebIDL::CallbackType> NetworkInformation::onchange()
+{
+    return event_handler_attribute(EventNames::change);
+}
+
+void NetworkInformation::did_change()
+{
+    dispatch_event(DOM::Event::create(m_window->principal_realm().global_object(), EventNames::change));
+}
+
+}
