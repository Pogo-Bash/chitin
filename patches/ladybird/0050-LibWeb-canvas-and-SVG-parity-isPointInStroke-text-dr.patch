+++ b/Libraries/LibGfx/PathSkia.cpp
@@ -16,7 +16,10 @@
 #include <core/SkFont.h>
 #include <core/SkPath.h>
 #include <core/SkPathBuilder.h>
+#include <core/SkPaint.h>
 #include <core/SkPathMeasure.h>
+#include <core/SkPathUtils.h>
+#include <effects/SkDashPathEffect.h>
 #include <utils/SkParsePath.h>
 
 template<>
@@ -340,4 +343,21 @@ String PathImplSkia::to_svg_string() const
     return MUST(String::from_utf8(StringView { svg_string.c_str(), svg_string.size() }));
 }
 
+bool path_stroke_contains(Path const& path, FloatPoint point, float thickness, Path::CapStyle cap_style, Path::JoinStyle join_style, float miter_limit, ReadonlySpan<float> dash_array, float dash_offset)
+{
+    if (!(thickness > 0))
+        return false;
+    SkPaint paint;
+    paint.setStyle(SkPaint::kStroke_Style);
+    paint.setStrokeWidth(thickness);
+    paint.setStrokeCap(to_skia_cap(cap_style));
+    paint.setStrokeJoin(to_skia_join(join_style));
+    paint.setStrokeMiter(miter_limit);
+    if (!dash_array.is_empty())
+        paint.setPathEffect(SkDashPathEffect::Make({ dash_array.data(), dash_array.size() }, dash_offset));
+    auto outline = skpathutils::FillPathWithPaint(to_skia_path(path), paint);
+    outline.setFillType(SkPathFillType::kWinding);
+    return outline.contains(point.x(), point.y());
+}
+
 }
diff --git a/Libraries/LibWeb/HTML/Canvas/Canvas2DContextBase.cpp b/Libraries/LibWeb/HTML/Canvas/Canvas2DContextBase.cpp
index 81965b81fa..bc9b651478 100644
--- a/Libraries/LibWeb/HTML/Canvas/Canvas2DContextBase.cpp
