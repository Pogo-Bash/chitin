+// Whether `point` is inside the outline a stroke of `path` with these line styles covers (CanvasRenderingContext2D.isPointInStroke).
+bool path_stroke_contains(Path const&, FloatPoint point, float thickness, Path::CapStyle, Path::JoinStyle, float miter_limit, ReadonlySpan<float> dash_array, float dash_offset);
