+// https://html.spec.whatwg.org/multipage/canvas.html#dom-context-2d-wordspacing
+template<typename CanvasType>
+Utf16String CanvasTextDrawingStyles<CanvasType>::word_spacing() const
+{
+    Utf16StringBuilder builder;
+    drawing_state().word_spacing->serialize(builder, CSS::SerializationMode::Normal);
+    return builder.to_string();
+}
+
+template<typename CanvasType>
+void CanvasTextDrawingStyles<CanvasType>::set_word_spacing(Utf16View word_spacing)
+{
+    // 1. Let parsed be the result of parsing the given value as a CSS <length>. 2. If parsed is failure, then return.
+    auto parsed = parse_css_type(CSS::Parser::ParsingParams { CSS::Parser::SpecialContext::CanvasContextGenericValue }, word_spacing, CSS::ValueType::Length);
+    if (!parsed)
+        return;
+    // 3. Set this's word spacing to parsed.
+    drawing_state().word_spacing = parsed.release_nonnull();
+}
+
 template<typename CanvasType>
 float CanvasTextDrawingStyles<CanvasType>::resolved_letter_spacing() const
 {
