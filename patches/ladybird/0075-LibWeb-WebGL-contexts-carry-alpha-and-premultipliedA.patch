diff --git a/Libraries/LibWeb/WebGL/WebGLRenderingContextImpl.cpp b/Libraries/LibWeb/WebGL/WebGLRenderingContextImpl.cpp
index c62b04334c..66e3405cf3 100644
--- a/Libraries/LibWeb/WebGL/WebGLRenderingContextImpl.cpp
+++ b/Libraries/LibWeb/WebGL/WebGLRenderingContextImpl.cpp
@@ -2354,7 +2354,9 @@ void WebGLRenderingContextImpl::renderbuffer_storage(WebIDL::UnsignedLong target
 {
     m_context->make_current();
 
-    if (internalformat == GL_DEPTH_STENCIL)
+    // NB: An executor that is itself a WebGL 1 implementation takes DEPTH_STENCIL as it is (DEPTH24_STENCIL8 is not a
+    //     WebGL 1 renderbuffer format there, and the upload was INVALID_ENUM).
+    if (internalformat == GL_DEPTH_STENCIL && !executor_is_webgl())
         internalformat = GL_DEPTH24_STENCIL8;
 
     m_context->renderbuffer_storage(target, internalformat, width, height);
