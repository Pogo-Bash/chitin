@@ -556,12 +556,12 @@ void CompositorConnection::hurry_rendering_opportunity(Web::CompositorContextId
     async_hurry_rendering_opportunity(context_id);
 }
 
-Optional<Compositing::CanvasId> CompositorConnection::create_webgl_context(Compositing::WebGL::WebGLVersion webgl_version, Gfx::IntSize size, bool depth, bool stencil, bool antialias, Vector<String>& out_supported_extensions)
+Optional<Compositing::CanvasId> CompositorConnection::create_webgl_context(Compositing::WebGL::WebGLVersion webgl_version, Gfx::IntSize size, bool depth, bool stencil, bool antialias, bool alpha, bool premultiplied_alpha, Vector<String>& out_supported_extensions)
 {
     if (!can_send_message_to_compositor())
         return {};
 
-    auto response = send_sync<Messages::CompositorWebContentServer::CreateWebglContext>(webgl_version, size, depth, stencil, antialias);
+    auto response = send_sync<Messages::CompositorWebContentServer::CreateWebglContext>(webgl_version, size, depth, stencil, antialias, alpha, premultiplied_alpha);
     out_supported_extensions = response->take_supported_extensions();
     if (!response->success())
         return {};
