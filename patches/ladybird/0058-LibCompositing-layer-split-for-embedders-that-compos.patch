+/// A contiguous range of commands, as (run, command in run): from `begin` up to, not including, `end`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ReplayRange {
+    pub begin: (u32, u32),
+    pub end: (u32, u32),
+}
+
+// The byte range of commands [first, last) of a run's records (`last` past the end means to the end).
+fn records_of_commands(records: &[u8], first: u32, last: u32) -> &[u8] {
+    let mut index = 0u32;
+    let mut start = records.len();
+    let mut end = records.len();
+    let mut found_start = first == 0;
+    if found_start {
+        start = 0;
+    }
+    for_each_command(records, |header, offset, _| {
+        if index == first && !found_start {
+            start = offset;
+            found_start = true;
+        }
+        if index == last {
+            end = offset;
+        }
+        let _ = header;
+        index += 1;
+    });
+    if start > end {
+        return &records[0..0];
+    }
+    &records[start..end]
+}
