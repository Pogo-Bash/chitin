--- a/Libraries/LibCompositing/Rust/src/ffi.rs
+++ b/Libraries/LibCompositing/Rust/src/ffi.rs
@@ -874,3 +874,332 @@ pub unsafe extern "C" fn visual_context_tree_test_builder_destroy(builder: *mut
     // SAFETY: The caller hands over the boxed tree the create call returned.
