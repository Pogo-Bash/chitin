+            let first = if index == range.begin.0 { range.begin.1 } else { 0 };
+            let last = if index == range.end.0 { range.end.1 } else { u32::MAX };
+            if first != 0 || last != u32::MAX {
+                records = records_of_commands(records, first, last);
+                if records.is_empty() {
+                    return;
+                }
+            }
+        }
         self.painter.execute_run(run_index, records, self.scroll_offsets);
     }
 
