+
+// --- Layer split for embedders that composite layers themselves (Chitin) -------------------------------------
+// A host that splits one display list into layers needs to know the runs (their contexts, ink bounds and commands),
+// the nodes of the tree (kinds, parents, clip rects, effects), and to replay a contiguous range of commands.
+
+/// One run of a recorded list: its context, the union of its draw commands' bounds in its spatial node's space,
+/// its command count, and the scroll node of a scroll bar it paints (0 when it paints none).
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct FfiLayerRunInfo {
+    pub context: ContextRef,
+    pub ink_bounds: libgfx_rust::IntRect,
+    pub command_count: u32,
+    pub scroll_bar_node: u32,
+    pub records: *const u8,
+    pub records_size: usize,
+}
+
+/// # Safety
+///
+/// `storage` must be a live storage handle and `out` writable. Returns false when `run` is out of range.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn display_list_layer_run_info(storage: *const c_void, run: usize, out: *mut FfiLayerRunInfo) -> bool {
+    let storage = unsafe { storage_from_handle(storage) };
+    let runs = storage.command_runs();
+    let Some(info) = runs.get(run) else {
+        return false;
+    };
+    let records = &storage.bytes()[info.offset as usize..(info.offset + info.size) as usize];
+    let mut command_count = 0u32;
+    let mut scroll_bar_node = 0u32;
+    crate::display_list::builder::for_each_command(records, |header, _, payload| {
+        command_count += 1;
+        if header.command_type == crate::display_list::commands::DisplayListCommandType::PaintScrollBar {
+            let command = crate::display_list::builder::read_command::<crate::display_list::commands::PaintScrollBar>(payload);
+            scroll_bar_node = command.scroll_node_index.0;
+        }
+    });
+    // SAFETY: The caller guarantees `out` is writable.
+    unsafe {
+        *out = FfiLayerRunInfo {
+            context: info.context,
+            ink_bounds: info.ink_bounds,
+            command_count,
+            scroll_bar_node,
+            records: records.as_ptr(),
+            records_size: records.len(),
+        };
+    }
+    true
+}
+
+/// Calls `visit` with each top-level command of the list: its run, its index in the run, its type, its bounding
+/// rect (in the run's spatial node space), and its byte offset in the run's records.
+///
+/// # Safety
+///
+/// `storage` must be a live storage handle. `visit` runs synchronously.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn display_list_layer_for_each_command(
+    storage: *const c_void,
+    context: *mut c_void,
+    visit: unsafe extern "C" fn(*mut c_void, u32, u32, crate::display_list::commands::DisplayListCommandType, libgfx_rust::IntRect, u32),
+) {
+    let storage = unsafe { storage_from_handle(storage) };
+    for (run_index, run) in storage.command_runs().iter().enumerate() {
+        let records = &storage.bytes()[run.offset as usize..(run.offset + run.size) as usize];
+        let mut index = 0u32;
+        crate::display_list::builder::for_each_command(records, |header, offset, _| {
+            // SAFETY: `visit` runs synchronously.
+            unsafe { visit(context, run_index as u32, index, header.command_type, header.bounding_rect, offset as u32) };
+            index += 1;
+        });
+    }
+}
+
+/// Replays the commands from (`begin_run`, `begin_command`) up to, not including, (`end_run`, `end_command`), in
+/// tape order, with every run's context entered as a whole replay enters it. A tree with 3D sorting contexts replays
+/// whole (a host splits such a list only at its ends).
+///
+/// # Safety
+///
+/// As `display_list_replay`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn display_list_replay_range(
+    tree: *const c_void,
+    storage: *const c_void,
+    scroll_offsets: *const libgfx_rust::FloatPoint,
+    scroll_offsets_len: usize,
+    callbacks: *const crate::host::FfiDisplayListReplayCallbacks,
+    begin_run: u32,
+    begin_command: u32,
+    end_run: u32,
+    end_command: u32,
+) {
+    // SAFETY: The caller guarantees live handles and a valid slice for the duration of the call.
+    let (tree, storage, scroll_offsets) = unsafe {
+        (
+            tree_from_handle(tree),
+            storage_from_handle(storage),
+            ffi_slice(scroll_offsets, scroll_offsets_len),
+        )
+    };
+    // SAFETY: The caller guarantees `callbacks` is live for the call.
+    let mut painter = unsafe { *callbacks };
+    crate::display_list::replay::replay_display_list_range(
+        tree,
+        storage.bytes(),
+        storage.command_runs(),
+        storage.effect_clip_plan(tree),
+        scroll_offsets,
+        &mut painter,
+        crate::display_list::replay::ReplayRange {
+            begin: (begin_run, begin_command),
+            end: (end_run, end_command),
+        },
+    );
+}
+
+/// What a spatial node is. `kind`: 0 dead, 1 scroll, 2 sticky, 3 transform, 4 perspective, 5 backface visibility,
+/// 6 anchor scroll shift. For a sticky node, its scroller, its insets (NaN when auto) and geometry (device pixels).
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct FfiLayerSpatialNodeInfo {
+    pub kind: u8,
+    pub parent: u32,
+    pub sticky_scroller: u32,
+    pub sticky_parent: u32,
+    pub sticky_position_relative_to_scroller: libgfx_rust::FloatPoint,
+    pub sticky_border_box_size: libgfx_rust::FloatSize,
+    pub sticky_scrollport_size: libgfx_rust::FloatSize,
+    pub sticky_containing_block_region: libgfx_rust::FloatRect,
+    pub sticky_insets: [f32; 4],
+    pub sticky_needs_parent_offset_adjustment: bool,
+    pub transform_sorting: bool,
+}
+
+/// # Safety
+///
+/// `tree` must be a live retained tree handle and `out` writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn visual_context_tree_layer_spatial_node_info(tree: *const c_void, index: u32, out: *mut FfiLayerSpatialNodeInfo) -> bool {
+    use crate::visual_context::SpatialData;
+    let tree = unsafe { tree_from_handle(tree) };
+    let Some(node) = tree.spatial_nodes.get(index as usize) else {
+        return false;
+    };
+    let mut info = FfiLayerSpatialNodeInfo {
+        kind: 0,
+        parent: node.parent.0,
+        sticky_scroller: 0,
+        sticky_parent: 0,
+        sticky_position_relative_to_scroller: libgfx_rust::FloatPoint::default(),
+        sticky_border_box_size: libgfx_rust::FloatSize::default(),
+        sticky_scrollport_size: libgfx_rust::FloatSize::default(),
+        sticky_containing_block_region: libgfx_rust::FloatRect::default(),
+        sticky_insets: [f32::NAN; 4],
+        sticky_needs_parent_offset_adjustment: false,
+        transform_sorting: false,
+    };
+    match &node.data {
+        SpatialData::Dead => {}
+        SpatialData::Scroll(_) => info.kind = 1,
+        SpatialData::Sticky(sticky) => {
+            info.kind = 2;
+            info.sticky_scroller = sticky.scroller.0;
+            info.sticky_parent = sticky.parent_sticky.map_or(0, |p| p.0);
+            info.sticky_position_relative_to_scroller = sticky.position_relative_to_scroller;
+            info.sticky_border_box_size = sticky.border_box_size;
+            info.sticky_scrollport_size = sticky.scrollport_size;
+            info.sticky_containing_block_region = sticky.containing_block_region;
+            info.sticky_insets = [
+                sticky.inset_top.unwrap_or(f32::NAN),
+                sticky.inset_right.unwrap_or(f32::NAN),
+                sticky.inset_bottom.unwrap_or(f32::NAN),
+                sticky.inset_left.unwrap_or(f32::NAN),
+            ];
+            info.sticky_needs_parent_offset_adjustment = sticky.needs_parent_offset_adjustment;
+        }
+        SpatialData::Transform(transform) => {
+            info.kind = 3;
+            info.transform_sorting = transform.sorting_context_root_index.is_some() || transform.establishes_sorting_context;
+        }
+        SpatialData::Perspective(_) => info.kind = 4,
+        SpatialData::BackfaceVisibility(_) => info.kind = 5,
+        SpatialData::AnchorScrollShift(_) => info.kind = 6,
+    }
+    // SAFETY: The caller guarantees `out` is writable.
+    unsafe { *out = info };
+    true
+}
+
+/// What a clip node is. `kind`: 0 dead, 1 rect (maybe rounded), 2 path. `rect` is in the node's spatial space (a
+/// path's device bounds for a path).
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct FfiLayerClipNodeInfo {
+    pub kind: u8,
+    pub parent: u32,
+    pub spatial: u32,
+    pub rect: libgfx_rust::FloatRect,
+    pub corner_radii: libgfx_rust::CornerRadii,
+    pub difference: bool,
+}
+
+/// # Safety
+///
+/// `tree` must be a live retained tree handle and `out` writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn visual_context_tree_layer_clip_node_info(tree: *const c_void, index: u32, out: *mut FfiLayerClipNodeInfo) -> bool {
+    use crate::visual_context::ClipNodeData;
+    let tree = unsafe { tree_from_handle(tree) };
+    let Some(node) = tree.clip_nodes.get(index as usize) else {
+        return false;
+    };
+    let mut info = FfiLayerClipNodeInfo {
+        kind: 0,
+        parent: node.parent.0,
+        spatial: node.spatial.0,
+        rect: libgfx_rust::FloatRect::default(),
+        corner_radii: libgfx_rust::CornerRadii::default(),
+        difference: false,
+    };
+    match &node.data {
+        ClipNodeData::Dead => {}
+        ClipNodeData::Rect(clip) => {
+            info.kind = 1;
+            info.rect = clip.rect;
+            info.corner_radii = clip.corner_radii;
+            info.difference = clip.mode != crate::display_list::commands::ClipMode::Intersect;
+        }
+        ClipNodeData::Path(path) => {
+            info.kind = 2;
+            let r = path.bounding_rect;
+            info.rect = libgfx_rust::FloatRect { x: r.x as f32, y: r.y as f32, width: r.width as f32, height: r.height as f32 };
+        }
+    }
+    // SAFETY: The caller guarantees `out` is writable.
+    unsafe { *out = info };
+    true
+}
+
+/// What an effect node is. `kind`: 0 dead, 1 effects (opacity, blend, filter, backdrop filter), 2 mask, 3 a
+/// background color animation marker. `pushes_layer`: whether replay pushes a layer for it.
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct FfiLayerEffectNodeInfo {
+    pub kind: u8,
+    pub parent: u32,
+    pub spatial: u32,
+    pub local_clip: u32,
+    pub pushes_layer: bool,
+    pub opacity: f32,
+    pub blend_normal: bool,
+    pub filter: *const u8,
+    pub filter_size: usize,
+    pub backdrop_filter: *const u8,
+    pub backdrop_filter_size: usize,
+    pub backdrop_region: libgfx_rust::IntRect,
+    pub backdrop_corner_radii: libgfx_rust::CornerRadii,
+}
+
+/// # Safety
+///
+/// `tree` must be a live retained tree handle and `out` writable. The filter pointers live as long as the tree.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn visual_context_tree_layer_effect_node_info(tree: *const c_void, index: u32, out: *mut FfiLayerEffectNodeInfo) -> bool {
+    use crate::visual_context::EffectNodeData;
+    let tree = unsafe { tree_from_handle(tree) };
+    let Some(node) = tree.effect_nodes.get(index as usize) else {
+        return false;
+    };
+    let mut info = FfiLayerEffectNodeInfo {
+        kind: 0,
+        parent: node.parent.0,
+        spatial: node.spatial.0,
+        local_clip: node.local_clip.0,
+        pushes_layer: tree.effect_pushes_layer_at_replay(EffectNodeIndex(index)),
+        opacity: 1.0,
+        blend_normal: true,
+        filter: std::ptr::null(),
+        filter_size: 0,
+        backdrop_filter: std::ptr::null(),
+        backdrop_filter_size: 0,
+        backdrop_region: libgfx_rust::IntRect::default(),
+        backdrop_corner_radii: libgfx_rust::CornerRadii::default(),
+    };
+    match &node.data {
+        EffectNodeData::Dead => info.pushes_layer = false,
+        EffectNodeData::Effects(effects) => {
+            info.kind = 1;
+            info.opacity = effects.opacity;
+            info.blend_normal = effects.blend_mode == libgfx_rust::CompositingAndBlendingOperator::Normal;
+            if let Some(filter) = &effects.filter {
+                info.filter = filter.as_ptr();
+                info.filter_size = filter.len();
+            }
+            if let Some(backdrop) = &effects.backdrop_filter {
+                info.backdrop_filter = backdrop.filter.as_ptr();
+                info.backdrop_filter_size = backdrop.filter.len();
+                info.backdrop_region = backdrop.region;
+                info.backdrop_corner_radii = backdrop.corner_radii;
+            }
+        }
+        EffectNodeData::Mask(_) => info.kind = 2,
+        EffectNodeData::BackgroundColorAnimation => info.kind = 3,
+    }
+    // SAFETY: The caller guarantees `out` is writable.
+    unsafe { *out = info };
+    true
+}
+
+/// # Safety
+///
+/// `tree` must be a live retained tree handle.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn visual_context_tree_layer_node_counts(tree: *const c_void, out_counts: *mut u32) {
+    let tree = unsafe { tree_from_handle(tree) };
+    let has_sorting = tree.spatial_nodes.iter().any(|node| {
+        matches!(&node.data, crate::visual_context::SpatialData::Transform(transform) if transform.sorting_context_root_index.is_some())
+    });
+    // SAFETY: The caller guarantees `out_counts` addresses four writable values.
+    unsafe {
+        *out_counts = tree.spatial_nodes.len() as u32;
+        *out_counts.add(1) = tree.clip_nodes.len() as u32;
+        *out_counts.add(2) = tree.effect_nodes.len() as u32;
+        *out_counts.add(3) = u32::from(has_sorting);
+    }
+}
