+/// A serialized filter as a list of simple functions, innermost first: blurs with one radius and color operations
+/// (saturate, and the ColorFilter kinds), for an embedder that draws such a filter itself (Chitin's compositor runs
+/// backdrop blurs on the host GPU). Returns how many were written, or 0 when the filter has anything else.
+///
+/// # Safety
+///
+/// `bytes` must address `size` readable bytes and `out` `capacity` writable functions.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn filter_bytes_simple_functions(bytes: *const u8, size: usize, out: *mut FfiFilterFunction, capacity: usize) -> usize {
+    if bytes.is_null() || size == 0 {
+        return 0;
+    }
+    // SAFETY: The caller guarantees `bytes` addresses `size` bytes.
+    let bytes = unsafe { std::slice::from_raw_parts(bytes, size) };
+    let Some(filter) = Filter::deserialize(bytes) else {
+        return 0;
+    };
+    let mut list = Vec::new();
+    fn walk(filter: &Filter, list: &mut Vec<FfiFilterFunction>) -> bool {
+        let simple = |kind, amount, color_operation| FfiFilterFunction {
+            kind,
+            amount,
+            offset_x: 0.0,
+            offset_y: 0.0,
+            color: libgfx_rust::Color::TRANSPARENT,
+            color_operation,
+        };
+        match filter {
+            Filter::Compose { outer, inner } => walk(inner, list) && walk(outer, list),
+            Filter::Blur { radius_x, radius_y, input } if radius_x == radius_y => {
+                if let Some(input) = input
+                    && !walk(input, list)
+                {
+                    return false;
+                }
+                list.push(simple(FfiFilterFunctionKind::Blur, *radius_x, libgfx_rust::ColorFilterType::Brightness));
+                true
+            }
+            Filter::Saturate { value, input } => {
+                if let Some(input) = input
+                    && !walk(input, list)
+                {
+                    return false;
+                }
+                list.push(simple(FfiFilterFunctionKind::Color, *value, libgfx_rust::ColorFilterType::Saturate));
+                true
+            }
+            Filter::ColorFilter { kind, amount, input } => {
+                if let Some(input) = input
+                    && !walk(input, list)
+                {
+                    return false;
+                }
+                list.push(simple(FfiFilterFunctionKind::Color, *amount, *kind));
+                true
+            }
+            _ => false,
+        }
+    }
+    if !walk(&filter, &mut list) || list.len() > capacity {
+        return 0;
+    }
+    for (i, function) in list.iter().enumerate() {
+        // SAFETY: The caller guarantees `out` addresses `capacity` functions.
+        unsafe { *out.add(i) = *function };
+    }
+    list.len()
+}
