+// https://w3c.github.io/pointerlock/#dom-document-exitpointerlock
 void Document::exit_pointer_lock()
 {
-    dbgln("FIXME: exit_pointer_lock()");
+    // A pending request is cancelled with the lock: its promise rejects as Chrome's does.
+    if (m_pending_pointer_lock_promise) {
+        auto promise = m_pending_pointer_lock_promise;
+        m_pending_pointer_lock_promise = nullptr;
+        m_pending_pointer_lock_element = nullptr;
+        WebIDL::reject_promise(*promise, WebIDL::NotAllowedError::create("The user has exited the lock before this request was completed."_utf16));
+        fire_pointer_lock_event(HTML::EventNames::pointerlockerror);
+        page().client().page_did_request_pointer_unlock();
+        return;
+    }
+    // 1. If this's pointer lock element is null, return.
+    if (!m_pointer_lock_element)
+        return;
+    // 2. Unlock: the embedder releases the host's lock; the element is unset and pointerlockchange fires.
+    m_pointer_lock_element = nullptr;
+    page().client().page_did_request_pointer_unlock();
+    fire_pointer_lock_event(HTML::EventNames::pointerlockchange);
+}
+
+GC::Ptr<Element> Document::retargeted_pointer_lock_element() const
+{
+    if (!m_pointer_lock_element)
+        return nullptr;
+    auto* candidate = retarget(m_pointer_lock_element.ptr(), const_cast<Document*>(this));
+    if (auto* element = as_if<Element>(candidate); element && &element->root() == &root())
+        return element;
+    return nullptr;
+}
+
+void Document::fire_pointer_lock_event(Utf16FlyString const& name)
+{
+    // Chrome fires both events at the document, not bubbling, from a task.
+    HTML::queue_global_task(HTML::Task::Source::UserInteraction, HTML::relevant_global_object(*this), GC::create_function(heap(), [this, name] {
+        auto event = Event::create(HTML::relevant_global_object(*this), name);
+        dispatch_event(event);
+    }));
+}
+
+// https://w3c.github.io/pointerlock/#dom-element-requestpointerlock
+WebIDL::ExceptionOr<void> Document::request_pointer_lock(GC::Ref<Element> element, bool unadjusted_movement, GC::Ref<WebIDL::Promise> promise)
+{
+    // The target must be connected and in this fully active document's tree (Chrome's WrongDocumentError).
+    if (!element->is_connected() || !is_fully_active() || &element->shadow_including_root() != this)
+        return WebIDL::WrongDocumentError::create("The root document of this element is not valid for pointer lock."_utf16);
+    if (m_pending_pointer_lock_promise)
+        return WebIDL::InvalidStateError::create("Pointer lock pending."_utf16);
+    // Changing the target of a held lock needs no activation; a new lock needs the page's transient activation.
+    if (!m_pointer_lock_element) {
+        auto window = this->window();
+        if (!window || !window->has_transient_activation())
+            return WebIDL::NotAllowedError::create("A user gesture is required to request Pointer Lock."_utf16);
+    }
+    m_pending_pointer_lock_element = element;
+    m_pending_pointer_lock_promise = promise;
+    page().client().page_did_request_pointer_lock(unadjusted_movement);
+    return {};
+}
+
+void Document::did_lock_pointer(int error)
+{
+    auto element = m_pending_pointer_lock_element;
+    auto promise = m_pending_pointer_lock_promise;
+    m_pending_pointer_lock_element = nullptr;
+    m_pending_pointer_lock_promise = nullptr;
+    if (!promise)
+        return;
+    if (error || !element || !element->is_connected()) {
+        if (error == 2)
+            WebIDL::reject_promise(*promise, WebIDL::NotSupportedError::create("The options asked for in this request are not supported on this platform."_utf16));
+        else
+            WebIDL::reject_promise(*promise, WebIDL::NotAllowedError::create("The user has exited the lock before this request was completed."_utf16));
+        fire_pointer_lock_event(HTML::EventNames::pointerlockerror);
+        if (!error)
+            page().client().page_did_request_pointer_unlock();
+        return;
+    }
+    // The promise first, pointerlockchange after the page's reactions to it (Chrome's order): a reaction of ours, attached after
+    // the page's, queues the event.
+    m_pointer_lock_element = element;
+    WebIDL::resolve_promise(*promise);
+    WebIDL::upon_fulfillment(*promise, GC::create_function(heap(), [this](JS::Value) -> WebIDL::ExceptionOr<JS::Value> {
+        fire_pointer_lock_event(HTML::EventNames::pointerlockchange);
+        return JS::js_undefined();
+    }));
+}
+
+void Document::did_unlock_pointer()
+{
+    if (m_pending_pointer_lock_promise) {
+        did_lock_pointer(1);
+        return;
+    }
+    if (!m_pointer_lock_element)
+        return;
+    m_pointer_lock_element = nullptr;
+    fire_pointer_lock_event(HTML::EventNames::pointerlockchange);
+}
+
+WebIDL::CallbackType* Document::onpointerlockchange()
+{
+    return event_handler_attribute(HTML::EventNames::pointerlockchange);
+}
+
+void Document::set_onpointerlockchange(WebIDL::CallbackType* value)
+{
+    set_event_handler_attribute(HTML::EventNames::pointerlockchange, value);
+}
+
+WebIDL::CallbackType* Document::onpointerlockerror()
+{
+    return event_handler_attribute(HTML::EventNames::pointerlockerror);
+}
+
+void Document::set_onpointerlockerror(WebIDL::CallbackType* value)
+{
+    set_event_handler_attribute(HTML::EventNames::pointerlockerror, value);
 }
 
 static bool contains_named_namespace(CSS::SelectorList const& selectors)
