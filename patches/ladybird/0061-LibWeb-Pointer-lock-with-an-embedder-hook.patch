+GC::Ptr<Element> ShadowRoot::retargeted_pointer_lock_element() const
+{
+    if (!host() || !host()->is_connected())
+        return nullptr;
+    auto* candidate = retarget(document().pointer_lock_element().ptr(), const_cast<ShadowRoot*>(this));
+    if (auto* element = as_if<Element>(candidate); element && &element->root() == &root())
+        return element;
+    return nullptr;
+}
