From aafdc2f0ad0b9a2d604684b857bac4de6eecff64 Mon Sep 17 00:00:00 2001
From: pogo-bash <pogo-bash@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:29:31 -0500
Subject: [PATCH] LibWeb: WebGL compressed texture extensions enable their
 formats

Only the S3TC extensions registered their formats, so compressedTexImage* refused ETC2/EAC, ETC1, ASTC, BPTC, RGTC and
PVRTC with INVALID_ENUM after the extension was enabled, and COMPRESSED_TEXTURE_FORMATS left them out.
---
 .../Extensions/EXTTextureCompressionBPTC.cpp  |  9 +++++
 .../Extensions/EXTTextureCompressionRGTC.cpp  |  9 +++++
 .../Extensions/WebGLCompressedTextureASTC.cpp | 33 +++++++++++++++++++
 .../Extensions/WebGLCompressedTextureETC.cpp  | 15 +++++++++
 .../Extensions/WebGLCompressedTextureETC1.cpp |  6 ++++
 .../WebGLCompressedTexturePVRTC.cpp           |  9 +++++
 6 files changed, 81 insertions(+)

diff --git a/Libraries/LibWeb/WebGL/Extensions/EXTTextureCompressionBPTC.cpp b/Libraries/LibWeb/WebGL/Extensions/EXTTextureCompressionBPTC.cpp
index 8b91e70a81..7639a2cf7b 100644
--- a/Libraries/LibWeb/WebGL/Extensions/EXTTextureCompressionBPTC.cpp
+++ b/Libraries/LibWeb/WebGL/Extensions/EXTTextureCompressionBPTC.cpp
@@ -23,6 +23,15 @@ GC::Ref<Bindings::Wrappable> EXTTextureCompressionBPTC::create(GC::Ref<WebGLRend
 EXTTextureCompressionBPTC::EXTTextureCompressionBPTC(JS::Realm&, GC::Ref<WebGLRenderingContextBase> context)
     : m_context(context)
 {
+    // The extension's formats, which compressedTexImage* and COMPRESSED_TEXTURE_FORMATS accept once it is enabled: BPTC (EXT_texture_compression_bptc).
+    static constexpr WebIDL::UnsignedLong formats[] = {
+        0x8E8C,
+        0x8E8D,
+        0x8E8E,
+        0x8E8F,
+    };
+    for (auto format : formats)
+        m_context->enable_compressed_texture_format(format);
 }
 
 
