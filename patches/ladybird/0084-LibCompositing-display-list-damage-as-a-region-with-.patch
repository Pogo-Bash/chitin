+
+const TAGGED_MAX: usize = 512;
+
+const REGION_MAX_RECTS: usize = 16;
+const REGION_MERGE_DISTANCE: i32 = 32;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum DamageCause {
+    Diff = 0,
+    Chain = 1,
+    Scrollbar = 2,
+}
+
+// `a` minus `b`: up to four rects (bands above and below, then left and right of the overlap).
+fn rect_difference(a: IntRect, b: IntRect) -> Vec<IntRect> {
+    let overlap = intersect_like_gfx_int_rect(a, b);
+    if overlap.is_empty() {
+        return if a.is_empty() { Vec::new() } else { vec![a] };
+    }
+    let mut out = Vec::with_capacity(4);
+    let mut push = |x: i32, y: i32, w: i32, h: i32| {
+        if w > 0 && h > 0 {
+            out.push(IntRect::new(x, y, w, h));
+        }
+    };
+    push(a.x, a.y, a.width, overlap.y - a.y);
+    push(a.x, overlap.bottom(), a.width, a.bottom() - overlap.bottom());
+    push(a.x, overlap.y, overlap.x - a.x, overlap.height);
+    push(overlap.right(), overlap.y, a.right() - overlap.right(), overlap.height);
+    out
+}
+
+fn rect_area(rect: IntRect) -> i64 {
+    rect.width.max(0) as i64 * rect.height.max(0) as i64
+}
+
+fn rects_near(a: IntRect, b: IntRect, distance: i32) -> bool {
+    a.x - distance <= b.right()
+        && b.x - distance <= a.right()
+        && a.y - distance <= b.bottom()
+        && b.y - distance <= a.bottom()
 }
 
 impl DamageAccumulator {
+    fn new(viewport_rect: IntRect) -> Self {
+        Self {
+            damage_rect: None,
+            changed_unbounded_command: false,
+            viewport_rect,
+            region: Vec::new(),
+            stats: [0; 16],
+            largest_area: 0,
+            tagged: Vec::new(),
+            new_run_hint: 0,
+        }
+    }
+
+    fn add_tagged(&mut self, rect: IntRect, run: u32) {
+        let full = self.tagged.len() >= TAGGED_MAX;
+        if let Some(last) = self.tagged.last_mut()
+            && (full
+                || (rects_near(last.rect, rect, REGION_MERGE_DISTANCE)
+                    && run + 2 >= last.first_run
+                    && run <= last.last_run + 2))
+        {
+            last.rect = last.rect.united(rect);
+            last.first_run = last.first_run.min(run);
+            last.last_run = last.last_run.max(run);
+            return;
+        }
+        self.tagged.push(TaggedDamage {
+            rect,
+            first_run: run,
+            last_run: run,
+        });
+    }
+
+    fn add_region_rect(&mut self, rect: IntRect, cause: DamageCause) {
+        let c = cause as usize;
+        self.stats[c] += 1;
+        let slot = 4 + 4 * c;
+        let previous = IntRect::new(
+            self.stats[slot],
+            self.stats[slot + 1],
+            self.stats[slot + 2],
+            self.stats[slot + 3],
+        );
+        let united = previous.united(rect);
+        self.stats[slot..slot + 4].copy_from_slice(&[united.x, united.y, united.width, united.height]);
+        let mut rect = rect;
+        // Absorb every rect this one touches (repeat: the grown rect can reach others).
+        loop {
+            let Some(index) = self
+                .region
+                .iter()
+                .position(|r| rects_near(*r, rect, REGION_MERGE_DISTANCE))
+            else {
+                break;
+            };
+            rect = rect.united(self.region.swap_remove(index));
+        }
+        self.region.push(rect);
+        while self.region.len() > REGION_MAX_RECTS {
+            let mut best = (0, 1, i64::MAX);
+            for i in 0..self.region.len() {
+                for j in i + 1..self.region.len() {
+                    let (a, b) = (self.region[i], self.region[j]);
+                    let cost = rect_area(a.united(b)) - rect_area(a) - rect_area(b);
+                    if cost < best.2 {
+                        best = (i, j, cost);
+                    }
+                }
+            }
+            let b = self.region.swap_remove(best.1);
+            self.region[best.0] = self.region[best.0].united(b);
+        }
+    }
