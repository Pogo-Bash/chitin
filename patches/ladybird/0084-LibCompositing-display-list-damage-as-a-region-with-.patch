+
+/// The damage as a region of a few rects (each inflated and clipped like the union), with why commands were damaged.
+pub struct DamageRegion {
+    pub bounds: IntRect,
+    pub rects: Vec<IntRect>,
+    pub stats: [i32; 16],
+    pub tagged: Vec<TaggedDamage>,
+}
+
