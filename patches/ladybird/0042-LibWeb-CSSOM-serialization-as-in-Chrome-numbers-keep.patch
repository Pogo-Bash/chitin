+// AD-HOC: as in Chrome, a family name is kept as an identifier only when it is one identifier that serializes without
+// escapes and is no keyword; otherwise it is kept as a string. So "Arial" serializes as Arial, and Times New Roman (three
+// identifiers) as "Times New Roman".
+fn is_plain_family_identifier(name: &[u16]) -> bool {
+    let is_name_unit = |unit: u16| unit >= 0x80 || unit == u16::from(b'-') || unit == u16::from(b'_') || (unit < 0x80 && (unit as u8).is_ascii_alphanumeric());
+    let Some(&first) = name.first() else {
+        return false;
+    };
+    if !name.iter().all(|&unit| is_name_unit(unit)) {
+        return false;
+    }
+    let is_digit = |unit: u16| unit < 0x80 && (unit as u8).is_ascii_digit();
+    if is_digit(first) {
+        return false;
+    }
+    if first == u16::from(b'-') && name.get(1).is_none_or(|&second| second == u16::from(b'-') || is_digit(second)) {
+        return false;
+    }
+    is_valid_custom_ident(name, &[])
+        && !keyword_from_ascii_case_insensitive(name).is_some_and(|keyword| keyword_to_generic_font_family(keyword).is_some())
+}
+
+fn family_name_value(name: &[u16]) -> StyleValueData {
+    if is_plain_family_identifier(name) {
+        StyleValueData::CustomIdent {
+            custom_ident: CssString::from_utf16(name),
+        }
+    } else {
+        string_style_value(name)
+    }
+}
+
