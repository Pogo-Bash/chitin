 // https://drafts.csswg.org/cssom/#serialize-a-css-value
+// AD-HOC: Chrome keeps six significant digits rather than six decimals (1.23456789 is "1.23457", 100 / 3 is
+// "33.3333"); below 1 the two rules agree, and at 10^6 and above the six-decimal rule is kept.
+static double round_to_six_significant_digits(double value)
+{
+    auto magnitude = AK::abs(value);
+    if (!(magnitude >= 1.0 && magnitude < 1000000.0))
+        return value;
+    auto integer_digits = static_cast<int>(__builtin_floor(__builtin_log10(magnitude))) + 1;
+    auto scale = __builtin_pow(10.0, static_cast<double>(6 - integer_digits));
+    return __builtin_round(value * scale) / scale;
+}
+
 void serialize_a_number(StringBuilder& builder, double value)
 {
     // -> <number>
@@ -198,7 +210,7 @@ void serialize_a_number(StringBuilder& builder, double value)
     }
 
     // FIXME: Prevent scientific notation for large values.
-    builder.appendff("{:.6}", value);
+    builder.appendff("{:.6}", round_to_six_significant_digits(value));
 }
 
 void serialize_a_number(Utf16StringBuilder& builder, double value)
@@ -216,7 +228,7 @@ void serialize_a_number(Utf16StringBuilder& builder, double value)
     }
 
     // FIXME: Prevent scientific notation for large values.
-    builder.appendff("{:.6}", value);
+    builder.appendff("{:.6}", round_to_six_significant_digits(value));
 }
 
 String serialize_an_identifier(Utf16View ident)
