+fn serialize_descriptor_value(descriptor: &DescriptorData) -> Option<TextSink> {
+    let mut value = TextSink::new();
+    if !serialize_style_value(&mut value, &descriptor.value, SerializationMode::Normal) {
+        return None;
+    }
+    Some(value)
+}
+
+// AD-HOC: the four margin descriptors of @page and its margin rules serialize as one `margin` shorthand when all four
+// are present (as in Chrome, and as serialize a CSS declaration block does for properties): top, right, bottom, left,
+// the shortest form.
+fn serialize_margin_shorthand(data: &DescriptorBlockData) -> Option<(usize, TextSink)> {
+    const SIDES: [&str; 4] = ["margin-top", "margin-right", "margin-bottom", "margin-left"];
+    let mut first = usize::MAX;
+    let mut values: Vec<Vec<u16>> = Vec::new();
+    for side in SIDES {
+        let side_units: Vec<u16> = side.encode_utf16().collect();
+        let index = data.descriptors.iter().position(|descriptor| descriptor.name.units() == side_units.as_slice())?;
+        first = first.min(index);
+        values.push(serialize_descriptor_value(&data.descriptors[index])?.into_utf16());
+    }
+    let count = if values[1] != values[3] {
+        4
+    } else if values[0] != values[2] {
+        3
+    } else if values[0] != values[1] {
+        2
+    } else {
+        1
+    };
+    let mut sink = TextSink::new();
+    sink.push_ascii("margin: ");
+    for (index, value) in values.iter().take(count).enumerate() {
+        if index != 0 {
+            sink.push_ascii(" ");
+        }
+        for &unit in value {
+            sink.push_code_unit(unit);
+        }
+    }
+    sink.push_ascii(";");
+    Some((first, sink))
+}
+
+fn is_margin_side(descriptor: &DescriptorData) -> bool {
+    ["margin-top", "margin-right", "margin-bottom", "margin-left"]
+        .iter()
+        .any(|side| descriptor.name.units() == side.encode_utf16().collect::<Vec<u16>>().as_slice())
+}
+
 fn serialize_descriptors(data: &DescriptorBlockData) -> Option<TextSink> {
     let mut sink = TextSink::new();
+    let margin = serialize_margin_shorthand(data);
+    let mut written = 0usize;
     for (index, descriptor) in data.descriptors.iter().enumerate() {
-        if index != 0 {
+        if let Some((first, shorthand)) = &margin
+            && is_margin_side(descriptor)
+        {
+            if index == *first {
+                if written != 0 {
+                    sink.push_ascii(" ");
+                }
+                sink.push_sink(shorthand);
+                written += 1;
+            }
+            continue;
+        }
+        if written != 0 {
             sink.push_ascii(" ");
         }
+        written += 1;
         // AD-HOC: Descriptors have no shorthand serialization or important flags.
         // Escape names consistently with serialize a CSS declaration.
         serialize_an_identifier(&mut sink, &StringUnits::Utf16(descriptor.name.units()));
