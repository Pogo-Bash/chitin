+/// AD-HOC: Chrome (and the values WPT's cssom tests expect from it) keeps six significant digits rather than six
+/// decimals: 1.23456789 is "1.23457" and 100 / 3 is "33.3333". Below 1 the two rules agree; at 10^6 and above the
+/// value is left to the six-decimal rule. Matches Web::CSS::round_to_six_significant_digits.
+pub(crate) fn round_to_six_significant_digits(value: f64) -> f64 {
+    let magnitude = value.abs();
+    if !(1.0..1_000_000.0).contains(&magnitude) {
+        return value;
+    }
+    let integer_digits = magnitude.log10().floor() as i32 + 1;
+    let scale = 10f64.powi(6 - integer_digits);
+    (value * scale).round() / scale
 }
 
