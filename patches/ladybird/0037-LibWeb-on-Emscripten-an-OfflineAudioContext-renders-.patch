diff --git a/Libraries/LibWeb/WebAudio/Rendering/OfflineAudioRenderer.h b/Libraries/LibWeb/WebAudio/Rendering/OfflineAudioRenderer.h
index 1838700e83..fab4b7cd0d 100644
--- a/Libraries/LibWeb/WebAudio/Rendering/OfflineAudioRenderer.h
+++ b/Libraries/LibWeb/WebAudio/Rendering/OfflineAudioRenderer.h
@@ -54,7 +54,11 @@ public:
     bool request_suspend(u64 frame);
     void resume();
 
+#ifdef AK_OS_EMSCRIPTEN
+    bool is_rendering_started() const { return m_thread != nullptr || m_rendering_on_event_loop; }
+#else
     bool is_rendering_started() const { return m_thread != nullptr; }
+#endif
     u64 frames_rendered() const { return m_frames_rendered.load(); }
 
     // Only safe to access on the control thread after the completion callback was invoked.
@@ -64,6 +68,12 @@ private:
     OfflineAudioRenderer(NonnullRefPtr<ControlMessageQueue>, NodeID destination_node_id, size_t number_of_channels, size_t length, float sample_rate, size_t quantum_size);
 
     intptr_t render_thread_main();
+    void render_one_quantum(u64 current_frame);
+#ifdef AK_OS_EMSCRIPTEN
+    void schedule_render_slice();
+    void render_slice();
+    bool m_rendering_on_event_loop { false };
+#endif
     void post_to_control_thread(Function<void(OfflineAudioRenderer&)>);
 
     NonnullRefPtr<ControlMessageQueue> m_control_message_queue;
