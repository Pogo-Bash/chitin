+bool WebGL2RenderingContextImpl::is_query(GC::Ptr<WebGLQuery> query)
+{
+    m_context->make_current();
+
+    if (!query)
+        return false;
+
+    auto handle_or_error = query->handle_for_query(this);
+    if (handle_or_error.is_error()) {
+        set_error(GL_INVALID_OPERATION);
+        return false;
+    }
+    auto handle = handle_or_error.release_value();
+    if (!handle.has_value())
+        return false;
+    return m_context->is_query(handle.value());
+}
+
+bool WebGL2RenderingContextImpl::is_sampler(GC::Ptr<WebGLSampler> sampler)
+{
+    m_context->make_current();
+
+    if (!sampler)
+        return false;
+
+    auto handle_or_error = sampler->handle_for_query(this);
+    if (handle_or_error.is_error()) {
+        set_error(GL_INVALID_OPERATION);
+        return false;
+    }
+    auto handle = handle_or_error.release_value();
+    if (!handle.has_value())
+        return false;
+    return m_context->is_sampler(handle.value());
+}
+
+bool WebGL2RenderingContextImpl::is_transform_feedback(GC::Ptr<WebGLTransformFeedback> transform_feedback)
+{
+    m_context->make_current();
+
+    if (!transform_feedback)
+        return false;
+
+    auto handle_or_error = transform_feedback->handle_for_query(this);
+    if (handle_or_error.is_error()) {
+        set_error(GL_INVALID_OPERATION);
+        return false;
+    }
+    auto handle = handle_or_error.release_value();
+    if (!handle.has_value())
+        return false;
+    return m_context->is_transform_feedback(handle.value());
+}
+
+bool WebGL2RenderingContextImpl::is_sync(GC::Ptr<WebGLSync> sync)
+{
+    m_context->make_current();
+
+    if (!sync)
+        return false;
+
+    // A deleted sync is not a sync, without an error (as Chrome); one from another context is INVALID_OPERATION.
+    auto handle_or_error = sync->sync_handle_for_query(this);
+    if (handle_or_error.is_error()) {
+        set_error(GL_INVALID_OPERATION);
+        return false;
+    }
+    auto handle = handle_or_error.release_value();
+    if (!handle.has_value())
+        return false;
+    return m_context->is_sync(static_cast<GLsync>(handle.value()));
+}
+
+WebIDL::Long WebGL2RenderingContextImpl::get_frag_data_location(GC::Ref<WebGLProgram> program, Utf16String name)
+{
+    m_context->make_current();
+
+    auto handle_or_error = program->handle(this);
+    if (handle_or_error.is_error()) {
+        set_error(GL_INVALID_OPERATION);
+        return -1;
+    }
+    auto name_null_terminated = null_terminated_utf8_string(name.utf16_view());
+    return m_context->get_frag_data_location(handle_or_error.release_value(), name_null_terminated.data());
+}
+
+void WebGL2RenderingContextImpl::copy_tex_sub_image3d(WebIDL::UnsignedLong target, WebIDL::Long level, WebIDL::Long xoffset, WebIDL::Long yoffset, WebIDL::Long zoffset, WebIDL::Long x, WebIDL::Long y, WebIDL::Long width, WebIDL::Long height)
+{
+    m_context->make_current();
+    m_context->copy_tex_sub_image3d(target, level, xoffset, yoffset, zoffset, x, y, width, height);
+}
+
 void WebGL2RenderingContextImpl::bind_vertex_array(GC::Ptr<WebGLVertexArrayObject> array)
 {
     m_context->make_current();
