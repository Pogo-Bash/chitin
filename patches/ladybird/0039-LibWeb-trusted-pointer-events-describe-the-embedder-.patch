+static PointerEvent::PlatformPointer s_platform_pointer;
+
+void PointerEvent::set_platform_pointer(PlatformPointer const& pointer)
+{
+    s_platform_pointer = pointer;
+}
+
+PointerEvent::PlatformPointer const& PointerEvent::platform_pointer()
+{
+    return s_platform_pointer;
+}
+
+void PointerEvent::apply_platform_pointer(PointerEventOptions& options)
+{
+    auto const& p = s_platform_pointer;
+    switch (p.type) {
+    case PlatformPointerType::Mouse:
+        options.pointer_type = PointerTypes::Mouse;
+        break;
+    case PlatformPointerType::Pen:
+        options.pointer_type = PointerTypes::Pen;
+        break;
+    case PlatformPointerType::Touch:
+        options.pointer_type = PointerTypes::Touch;
+        break;
+    }
+    options.pointer_id = p.id;
+    options.width = p.width;
+    options.height = p.height;
+    options.is_primary = p.is_primary;
+    // https://w3c.github.io/pointerevents/#dom-pointerevent-pressure
+    if (options.buttons == 0)
+        options.pressure = 0;
+    else
+        options.pressure = p.pressure < 0 ? ACTIVE_PRESSURE_DEFAULT_IN_ACTIVE_BUTTON_STATE : p.pressure;
+}
