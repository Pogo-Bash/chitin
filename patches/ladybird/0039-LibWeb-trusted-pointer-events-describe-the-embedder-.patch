+    // The platform pointer the embedder's next input describes (Chitin): its type, id, contact size, pressure (negative: none
+    // reported, so 0.5 while a button is down and 0 otherwise) and whether it is the primary pointer. Trusted pointer events,
+    // and the click, auxclick and contextmenu PointerEvents the mouse events lead to, take these from it.
+    enum class PlatformPointerType : u8 {
+        Mouse,
+        Pen,
+        Touch,
+    };
+    struct PlatformPointer {
+        PlatformPointerType type { PlatformPointerType::Mouse };
+        WebIDL::Long id { 1 };
+        double width { 1 };
+        double height { 1 };
+        float pressure { -1 };
+        bool is_primary { true };
+    };
+    static void set_platform_pointer(PlatformPointer const&);
+    static PlatformPointer const& platform_pointer();
+    static void apply_platform_pointer(PointerEventOptions&);
 
