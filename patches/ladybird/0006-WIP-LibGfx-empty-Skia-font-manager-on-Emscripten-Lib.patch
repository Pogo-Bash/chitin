From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pogo-bash <pogo-bash@users.noreply.github.com>
Date: Sun, 11 Oct 2026 13:33:23 -0500
Subject: [PATCH 06/23] WIP: LibGfx empty Skia font manager on Emscripten;
 LibWasm pointer/u64 casts for wasm32, no Cranelift trap messages without
 compiled code

---
 Libraries/LibGfx/Font/TypefaceSkia.cpp        |  5 ++++
 .../LibWasm/AbstractMachine/AbstractMachine.h | 12 ++++-----
 .../AbstractMachine/BytecodeInterpreter.cpp   | 25 +++++++++++--------
 3 files changed, 25 insertions(+), 17 deletions(-)

diff --git a/Libraries/LibGfx/Font/TypefaceSkia.cpp b/Libraries/LibGfx/Font/TypefaceSkia.cpp
index 2c869c9339..8d30305a21 100644
--- a/Libraries/LibGfx/Font/TypefaceSkia.cpp
+++ b/Libraries/LibGfx/Font/TypefaceSkia.cpp
@@ -31,6 +31,9 @@
 #elif defined(AK_OS_WINDOWS)
 #    include <ports/SkFontMgr_empty.h>
 #    include <ports/SkTypeface_win.h>
+#elif defined(AK_OS_EMSCRIPTEN)
+// No system fonts: every typeface is made from bytes the embedder provides.
+#    include <ports/SkFontMgr_empty.h>
 #else
 #    include <ports/SkFontMgr_fontconfig.h>
 #    include <ports/SkFontScanner_FreeType.h>
@@ -110,6 +113,8 @@ static SkFontMgr& font_manager()
             font_manager = SkFontMgr_New_Custom_Empty();
         else
             font_manager = SkFontMgr_New_DirectWrite();
+#elif defined(AK_OS_EMSCRIPTEN)
+        font_manager = SkFontMgr_New_Custom_Empty();
 #else
         if (!font_manager) {
             font_manager = SkFontMgr_New_FontConfig(nullptr, SkFontScanner_Make_FreeType());
diff --git a/Libraries/LibWasm/AbstractMachine/AbstractMachine.h b/Libraries/LibWasm/AbstractMachine/AbstractMachine.h
index 384ad2a99f..07ea556373 100644
--- a/Libraries/LibWasm/AbstractMachine/AbstractMachine.h
+++ b/Libraries/LibWasm/AbstractMachine/AbstractMachine.h
@@ -188,7 +188,7 @@ public:
         // 10: a host externref viewed as a value in the any hierarchy (any.convert_extern)
         // anything else: funcref, where high is the defining Module* (null for host functions)
         ref.ref().visit(
-            [&](Reference::Func const& func) { m_value = u128(bit_cast<u64>(func.address), bit_cast<u64>(func.source_module.ptr())); },
+            [&](Reference::Func const& func) { m_value = u128(bit_cast<u64>(func.address), static_cast<u64>(reinterpret_cast<FlatPtr>(func.source_module.ptr()))); },
             [&](Reference::Extern const& func) { m_value = u128(bit_cast<u64>(func.address), 1); },
             [&](Reference::Null const& null) {
                 switch (null.type.kind()) {
@@ -211,7 +211,7 @@ public:
             },
             [&](Reference::Exception const& exn) { m_value = u128(bit_cast<u64>(exn.address), 5); },
             [&](Reference::I31 const& i31) { m_value = u128(static_cast<u64>(i31.value & 0x7fffffff), 7); },
-            [&](Reference::GcObject const& object) { m_value = u128(bit_cast<u64>(object.ptr.ptr()), 6); });
+            [&](Reference::GcObject const& object) { m_value = u128(static_cast<u64>(reinterpret_cast<FlatPtr>(object.ptr.ptr())), 6); });
     }
 
     // The gc cell behind this value if it holds a gc object reference, otherwise null.
@@ -220,7 +220,7 @@ public:
         // A gc object, either plain (tag 6) or externalized by extern.convert_any (tag 9
         // wrapping tag 6).
         if (m_value.high() == 6 || m_value.high() == (9 | (6 << 8)))
-            return bit_cast<GC::Cell*>(m_value.low());
+            return reinterpret_cast<GC::Cell*>(static_cast<FlatPtr>(m_value.low()));
         return nullptr;
     }
 
@@ -269,14 +269,14 @@ public:
             case 5:
                 return Reference { Reference::Exception { bit_cast<ExceptionAddress>(m_value.low()) } };
             case 6:
-                return Reference { Reference::GcObject { bit_cast<GC::Cell*>(m_value.low()) } };
+                return Reference { Reference::GcObject { reinterpret_cast<GC::Cell*>(static_cast<FlatPtr>(m_value.low())) } };
             case 7:
                 return Reference { Reference::I31 { static_cast<u32>(m_value.low()) } };
             case 8:
                 return Reference { Reference::Null { ValueType(ValueType::Kind::AnyReference) } };
             case 9 | (6 << 8):
                 // An externalized gc object; boxing drops the extern.convert_any wrapper.
-                return Reference { Reference::GcObject { bit_cast<GC::Cell*>(m_value.low()) } };
+                return Reference { Reference::GcObject { reinterpret_cast<GC::Cell*>(static_cast<FlatPtr>(m_value.low())) } };
             case 9 | (7 << 8):
                 // An externalized i31; boxing drops the extern.convert_any wrapper.
                 return Reference { Reference::I31 { static_cast<u32>(m_value.low()) } };
@@ -284,7 +284,7 @@ public:
                 // A host externref internalized by any.convert_extern; boxing drops the wrapper.
                 return Reference { Reference::Extern { bit_cast<ExternAddress>(m_value.low()) } };
             default:
-                return Reference { Reference::Func { bit_cast<FunctionAddress>(m_value.low()), bit_cast<Wasm::Module*>(m_value.high()) } };
+                return Reference { Reference::Func { bit_cast<FunctionAddress>(m_value.low()), reinterpret_cast<Wasm::Module*>(static_cast<FlatPtr>(m_value.high())) } };
             }
         }
         VERIFY_NOT_REACHED();
diff --git a/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp b/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
index 89823c8e02..3bbc882b67 100644
