 }
@@ -6338,7 +6341,7 @@ HANDLE_INSTRUCTION(array_fill)
     auto offset = value_stack.take_last().to<u32>();
     auto reference = value_stack.take_last();
     GC_TRAP_IF(is_null_gc_reference(reference), "null array reference");
