# Pinned toolchain for Chitin (see docs/toolchain.md). Sourced by the Makefile and tools/*.sh.
CHITIN_EXT="${CHITIN_EXT:-$HOME/dev/chitin-ext}"
EMSDK_DIR="${EMSDK_DIR:-$CHITIN_EXT/emsdk}"
# Emscripten 4.0.11 = emscripten-releases 7033fec38817ec01909b044ea0193ddd5057255c,
# clang 21.0.0git (llvm-project 0f0079c29da4b4d5bbd43dced1db9ad6c6d11008), libc++ 20.1.
EMSCRIPTEN_VERSION=4.0.11
EMSCRIPTEN_RELEASE_HASH=7033fec38817ec01909b044ea0193ddd5057255c
EMSDK_COMMIT=35ff8a6d150541276abbc6bae512ca90bcfbe220
# emsdk needs Python >= 3.10; macOS ships 3.9.
EMSDK_PYTHON="${EMSDK_PYTHON:-$(command -v python3.12 || command -v python3.11 || command -v python3.10 || echo python3)}"
