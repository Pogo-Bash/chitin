# Pinned Ladybird for Ganglion (phase 1). Sourced by tools/*.sh.
# The checkout lives outside the repo: $CHITIN_EXT/ladybird-src (a full clone, so patches can be
# rebased). Our changes are the patch series in patches/ladybird/, applied by tools/ladybird-apply.sh.
LADYBIRD_REPO=https://github.com/LadybirdBrowser/ladybird.git
LADYBIRD_COMMIT=975740ccd4de6bcdb92e7566fac8d799f32acdca
# 2026-10-11 18:19:03 +0200, "LibWeb: Size non-shrinkable flex items by max-content in min-content"
LADYBIRD_SRC="${LADYBIRD_SRC:-${CHITIN_EXT:-$HOME/dev/chitin-ext}/ladybird-src}"
SKIA_BRANCH=chrome/m148
SKIA_COMMIT=13ffba253fc7854fd3b34f67c82dfb2418dc2944
RUST_TOOLCHAIN=1.98.0
